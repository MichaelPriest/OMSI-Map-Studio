<UserControl
    x:Class="MapStudio.Native.Controls.RealWorldGenerationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="16"
        CornerRadius="10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        Text="Geração de mapa real"
                        FontSize="16"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="StageText"
                        Text="Pronto"
                        FontSize="11"
                        Opacity="0.68" />
                </StackPanel>

                <Button
                    x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancelar"
                    IsEnabled="False"
                    Click="OnCancelClick" />
            </Grid>

            <TextBlock
                x:Name="StatusText"
                Text="Pronto para gerar mapa real."
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="AssetIndexPanel"
                Spacing="5"
                Visibility="Collapsed">
                <Grid>
                    <TextBlock Text="Biblioteca OMSI" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="AssetIndexText"
                        HorizontalAlignment="Right"
                        Opacity="0.72" />
                </Grid>
            </StackPanel>

            <StackPanel
                x:Name="ElevationPanel"
                Spacing="5"
                Visibility="Collapsed">
                <Grid>
                    <TextBlock Text="Elevação real" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="ElevationText"
                        HorizontalAlignment="Right"
                        Opacity="0.72" />
                </Grid>
                <ProgressBar
                    x:Name="ElevationProgressBar"
                    Minimum="0"
                    Maximum="100"
                    Value="0" />
            </StackPanel>

            <StackPanel
                x:Name="SummaryPanel"
                Spacing="5"
                Visibility="Collapsed">
                <TextBlock
                    Text="Resultado"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="SummaryText"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="BackupText"
                    FontSize="11"
                    Opacity="0.68"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
