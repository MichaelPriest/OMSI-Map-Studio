<UserControl
    x:Class="MapStudio.Native.Controls.NativeViewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="InputSurface"
        Background="#111A20"
        PointerPressed="OnPointerPressed"
        PointerMoved="OnPointerMoved"
        PointerReleased="OnPointerReleased"
        PointerWheelChanged="OnPointerWheelChanged">

        <SwapChainPanel x:Name="SwapChainSurface" />

        <Border
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="12"
            Padding="10,6"
            Background="#CC07131D"
            CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Viewport nativo"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="RuntimeText"
                           Text="Inicializando Direct3D 11..."
                           FontSize="12"
                           Foreground="#8DB3CA" />
            </StackPanel>
        </Border>

        <Border
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="12"
            Padding="8,4"
            Background="#AA07131D"
            CornerRadius="4">
            <TextBlock
                x:Name="PointerText"
                Text="x: 0 · y: 0"
                Foreground="#9FC7DE" />
        </Border>
    </Grid>
</UserControl>
