<Application
    x:Class="MapStudio.Native.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="MapStudioSurfaceRaisedColor">#F0F1F3</Color>
                    <Color x:Key="MapStudioBorderColor">#E0E2E5</Color>
                    <Color x:Key="MapStudioBorderStrongColor">#BCC2C9</Color>
                    <Color x:Key="MapStudioAccentColor">#2563C4</Color>
                    <Color x:Key="MapStudioAccentSurfaceColor">#DCEAFF</Color>

                    <SolidColorBrush x:Key="MapStudioWindowBackgroundBrush" Color="#F5F6F7" />
                    <SolidColorBrush x:Key="MapStudioChromeBackgroundBrush" Color="#FCFCFD" />
                    <SolidColorBrush x:Key="MapStudioSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MapStudioSurfaceAltBrush" Color="#F5F6F7" />
                    <SolidColorBrush x:Key="MapStudioSurfaceRaisedBrush" Color="#F0F1F3" />
                    <SolidColorBrush x:Key="MapStudioBorderBrush" Color="#E0E2E5" />
                    <SolidColorBrush x:Key="MapStudioBorderStrongBrush" Color="#BCC2C9" />
                    <SolidColorBrush x:Key="MapStudioTextPrimaryBrush" Color="#20242A" />
                    <SolidColorBrush x:Key="MapStudioTextSecondaryBrush" Color="#48515C" />
                    <SolidColorBrush x:Key="MapStudioTextMutedBrush" Color="#606A75" />
                    <SolidColorBrush x:Key="MapStudioAccentBrush" Color="#2563C4" />
                    <SolidColorBrush x:Key="MapStudioAccentSurfaceBrush" Color="#DCEAFF" />
                    <SolidColorBrush x:Key="MapStudioAccentTextBrush" Color="#174F9E" />
                    <SolidColorBrush x:Key="MapStudioSuccessBrush" Color="#258552" />
                    <SolidColorBrush x:Key="MapStudioTranslucentSurfaceBrush" Color="#FAFCFCFD" />
                    <SolidColorBrush x:Key="MapStudioTranslucentRaisedBrush" Color="#F5F0F1F3" />
                    <SolidColorBrush x:Key="MapStudioPanelBackgroundBrush" Color="#FCFCFD" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="MapStudioSurfaceRaisedColor">#25282D</Color>
                    <Color x:Key="MapStudioBorderColor">#30343A</Color>
                    <Color x:Key="MapStudioBorderStrongColor">#454B53</Color>
                    <Color x:Key="MapStudioAccentColor">#589EFF</Color>
                    <Color x:Key="MapStudioAccentSurfaceColor">#234B7D</Color>

                    <SolidColorBrush x:Key="MapStudioWindowBackgroundBrush" Color="#17191D" />
                    <SolidColorBrush x:Key="MapStudioChromeBackgroundBrush" Color="#1D1F23" />
                    <SolidColorBrush x:Key="MapStudioSurfaceBrush" Color="#202328" />
                    <SolidColorBrush x:Key="MapStudioSurfaceAltBrush" Color="#22252A" />
                    <SolidColorBrush x:Key="MapStudioSurfaceRaisedBrush" Color="#25282D" />
                    <SolidColorBrush x:Key="MapStudioBorderBrush" Color="#30343A" />
                    <SolidColorBrush x:Key="MapStudioBorderStrongBrush" Color="#454B53" />
                    <SolidColorBrush x:Key="MapStudioTextPrimaryBrush" Color="#EFF1F4" />
                    <SolidColorBrush x:Key="MapStudioTextSecondaryBrush" Color="#C1C7CF" />
                    <SolidColorBrush x:Key="MapStudioTextMutedBrush" Color="#A2ABB7" />
                    <SolidColorBrush x:Key="MapStudioAccentBrush" Color="#589EFF" />
                    <SolidColorBrush x:Key="MapStudioAccentSurfaceBrush" Color="#234B7D" />
                    <SolidColorBrush x:Key="MapStudioAccentTextBrush" Color="#C6E0FF" />
                    <SolidColorBrush x:Key="MapStudioSuccessBrush" Color="#62DC92" />
                    <SolidColorBrush x:Key="MapStudioTranslucentSurfaceBrush" Color="#FA1D1F23" />
                    <SolidColorBrush x:Key="MapStudioTranslucentRaisedBrush" Color="#F525282D" />
                    <SolidColorBrush x:Key="MapStudioPanelBackgroundBrush" Color="#1D1F23" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="MapStudioSurfaceRaisedColor">#000000</Color>
                    <Color x:Key="MapStudioBorderColor">#FFFFFF</Color>
                    <Color x:Key="MapStudioBorderStrongColor">#FFFFFF</Color>
                    <Color x:Key="MapStudioAccentColor">#FFFF00</Color>
                    <Color x:Key="MapStudioAccentSurfaceColor">#000000</Color>

                    <SolidColorBrush x:Key="MapStudioWindowBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="MapStudioChromeBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="MapStudioSurfaceBrush" Color="#000000" />
                    <SolidColorBrush x:Key="MapStudioSurfaceAltBrush" Color="#000000" />
                    <SolidColorBrush x:Key="MapStudioSurfaceRaisedBrush" Color="#000000" />
                    <SolidColorBrush x:Key="MapStudioBorderBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MapStudioBorderStrongBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MapStudioTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MapStudioTextSecondaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MapStudioTextMutedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MapStudioAccentBrush" Color="#FFFF00" />
                    <SolidColorBrush x:Key="MapStudioAccentSurfaceBrush" Color="#000000" />
                    <SolidColorBrush x:Key="MapStudioAccentTextBrush" Color="#FFFF00" />
                    <SolidColorBrush x:Key="MapStudioSuccessBrush" Color="#00FF00" />
                    <SolidColorBrush x:Key="MapStudioTranslucentSurfaceBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="MapStudioTranslucentRaisedBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="MapStudioPanelBackgroundBrush" Color="#FF000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
