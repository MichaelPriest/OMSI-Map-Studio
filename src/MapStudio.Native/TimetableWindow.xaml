<Window
    x:Class="MapStudio.Native.TimetableWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OMSI Map Studio — Timetable">

    <Grid x:Name="RootGrid"
          Background="#08131D"
          Padding="16"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="TIMETABLE"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#DDF4FF" />
                <TextBlock Text="Lines · Tours · Trips · horários OMSI"
                           FontSize="11"
                           Foreground="#7FC6E8" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="Janela destacável"
                       FontSize="10"
                       Foreground="#7895AD" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="LineComboBox"
                      Grid.Column="0"
                      Header="Line"
                      DisplayMemberPath="Name"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnLineSelectionChanged" />

            <TextBlock x:Name="LineSummaryText"
                       Grid.Column="1"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,7"
                       TextWrapping="Wrap"
                       Foreground="#9FB5C5" />

            <Button x:Name="FocusTripButton"
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,4"
                    Content="Focar Trip no mapa"
                    IsEnabled="False"
                    Click="OnFocusTripClick" />

            <Button x:Name="EditTripButton"
                    Grid.Column="3"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,4"
                    Content="Editar Trip"
                    IsEnabled="False"
                    Click="OnEditTripClick" />

            <Button x:Name="EditProfileButton"
                    Grid.Column="4"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,4"
                    Content="Editar perfil"
                    IsEnabled="False"
                    Click="OnEditProfileClick" />

            <Button x:Name="EditLineButton"
                    Grid.Column="5"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,4"
                    Content="Editar Line"
                    Click="OnEditLineClick" />
        </Grid>

        <Border x:Name="ScheduleHeader" Grid.Row="2"
                Background="#0B202D"
                BorderBrush="#2C5367"
                BorderThickness="1"
                CornerRadius="7"
                Padding="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Tour"
                           FontWeight="SemiBold"
                           Foreground="#9EDCF4" />
                <TextBlock Grid.Column="1"
                           Text="AI Group"
                           FontWeight="SemiBold"
                           Foreground="#9EDCF4" />
                <TextBlock Grid.Column="2"
                           Text="Trip"
                           FontWeight="SemiBold"
                           Foreground="#9EDCF4" />
                <TextBlock Grid.Column="3"
                           Text="Saída"
                           FontWeight="SemiBold"
                           Foreground="#9EDCF4" />
                <TextBlock Grid.Column="4"
                           Text="Destino / linha"
                           FontWeight="SemiBold"
                           Foreground="#9EDCF4" />
                <TextBlock Grid.Column="5"
                           Text="Rota"
                           FontWeight="SemiBold"
                           Foreground="#9EDCF4" />
            </Grid>
        </Border>

        <Grid x:Name="EditorPanel" Grid.Row="2" Grid.RowSpan="2"
              Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveLineButton" Content="Salvar Line/Tours" Click="OnSaveLineClick" />
                <Button x:Name="DiscardLineButton" Content="Descartar edição" Click="OnDiscardLineClick" />
            </StackPanel>
            <TextBlock x:Name="EditorStatusText" Grid.Row="1" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="EditorHost" HorizontalContentAlignment="Stretch" />
            </ScrollViewer>
        </Grid>

        <ListView x:Name="ScheduleListView"
                  Grid.Row="3"
                  SelectionMode="Single"
                  SelectionChanged="OnScheduleSelectionChanged"
                  DoubleTapped="OnScheduleDoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,2"
                            Padding="8,6"
                            Background="#071722"
                            BorderBrush="#18394A"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding TourName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AiGroupName}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#9FB5C5" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding TripName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding DepartureText}"
                                       FontFamily="Consolas"
                                       Foreground="#9EDCF4" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding DestinationText}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#9FB5C5" />
                            <TextBlock Grid.Column="5"
                                       Text="{Binding RouteText}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#7FC6E8" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
