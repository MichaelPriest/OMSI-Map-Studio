                                    <Button x:Name="DeleteSelectionButton"
                                            Grid.Column="1"
                                            Content="Excluir"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Click="OnDeleteSelectionClick" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="InspectorTerrainFields"
                                Visibility="Collapsed"
                                Background="#0D2330"
                                BorderBrush="#294A5D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Terreno"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#DDF4FF" />
                                <Button x:Name="PickTerrainPointButton"
                                        Content="Escolher ponto no mapa"
                                        HorizontalAlignment="Stretch"
                                        Click="OnPickTerrainPointClick" />
                                <TextBlock x:Name="TerrainPointText"
                                           Text="Nenhum ponto selecionado."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#9FB5C5" />
                                <NumberBox x:Name="TerrainTargetHeightBox"
                                           Header="Altura alvo (m)"
                                           SpinButtonPlacementMode="Compact"
                                           SmallChange="0.25" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="TerrainBrushRadiusBox"
                                               Grid.Column="0"
                                               Header="Raio (m)"
                                               Value="20"
                                               Minimum="0.25"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" />
                                    <NumberBox x:Name="TerrainBrushFeatherBox"
                                               Grid.Column="1"
                                               Header="Suavização (0–1)"
                                               Value="0.25"
                                               Minimum="0"
                                               Maximum="1"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="0.05" />
                                </Grid>
                                <Button x:Name="ApplyTerrainLevelButton"
                                        Content="Aplicar nivelamento"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Click="OnApplyTerrainLevelClick" />
                                <NumberBox x:Name="TerrainBrushDeltaBox"
                                           Header="Força elevar/abaixar (m)"
                                           Value="1"
                                           Minimum="0.05"
                                           Maximum="100"
                                           SpinButtonPlacementMode="Compact"
                                           SmallChange="0.25" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RaiseTerrainButton"
                                            Grid.Column="0"
                                            Content="Elevar"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Click="OnRaiseTerrainClick" />
                                    <Button x:Name="LowerTerrainButton"
                                            Grid.Column="1"
                                            Content="Abaixar"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Click="OnLowerTerrainClick" />
                                </Grid>
                                <TextBlock Text="Textura / material"
                                           Margin="0,5,0,0"
                                           FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="TerrainPaintLayerBox"
                                               Grid.Column="0"
                                               Header="Groundtex"
                                               Value="1"
                                               Minimum="1"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" />
                                    <NumberBox x:Name="TerrainPaintAlphaBox"
                                               Grid.Column="1"
                                               Header="Alpha 0–255"
                                               Value="255"
                                               Minimum="0"
                                               Maximum="255"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="16" />
                                </Grid>
                                <Button x:Name="ApplyTerrainPaintButton"
                                        Content="Pintar textura no ponto"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Click="OnApplyTerrainPaintClick" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Seleção e edição compartilham o estado nativo do viewport e do ID Buffer."
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="#66899D" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Background="#061018"
              Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Text="Runtime nativo pronto para inicialização" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="WinUI 3 · Direct3D 11 · .NET 10"
                       Foreground="#7FA6BF" />
        </Grid>
    </Grid>
</Window>
