<Window
    x:Class="MapStudio.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MapStudio.Native.Controls"
    Title="OMSI Map Studio Native">

    <Grid Background="#08131D">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Arquivo" />
            <MenuBarItem Title="Editar" />
            <MenuBarItem Title="Visualizar" />
            <MenuBarItem Title="Mapa" />
            <MenuBarItem Title="Ferramentas" />
            <MenuBarItem Title="Ajuda" />
        </MenuBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="8"
                    Background="#0C2130"
                    CornerRadius="8">
                <StackPanel Padding="14" Spacing="10">
                    <TextBlock Text="Explorer"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBox PlaceholderText="Buscar objetos e splines..." />
                    <TextBlock Text="A migração preserva o Core real do OMSI. Este painel será ligado ao catálogo/indexador já existente."
                               TextWrapping="Wrap"
                               Foreground="#9FB5C5" />
                </StackPanel>
            </Border>

            <controls:NativeViewport
                x:Name="Viewport"
                Grid.Column="1"
                Margin="0,8" />

            <Border Grid.Column="2"
                    Margin="8"
                    Background="#0C2130"
                    CornerRadius="8">
                <StackPanel Padding="14" Spacing="10">
                    <TextBlock Text="Inspector"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectionText"
                               Text="Sem seleção"
                               Foreground="#9FB5C5" />
                    <TextBlock Text="O novo seletor usará ID buffer nativo: 1 pixel = 1 ID OMSI."
                               TextWrapping="Wrap"
                               Foreground="#9FB5C5" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Background="#061018"
              Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Text="Runtime nativo pronto para inicialização" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="WinUI 3 · Direct3D 11 · .NET 10"
                       Foreground="#7FA6BF" />
        </Grid>
    </Grid>
</Window>
