                                            Spacing="5">
                                    <Button Content="1 · Tracks"
                                            Click="OnTransportStepTracksClick" />
                                    <Button Content="2 · Station Links"
                                            Click="OnTransportStepStationLinksClick" />
                                    <Button Content="3 · Trips"
                                            Click="OnTransportStepTripsClick" />
                                    <Button Content="4 · Perfis"
                                            Click="OnTransportStepProfilesClick" />
                                    <Button Content="5 · Horários"
                                            Click="OnTransportStepTimetableClick" />
                                    <Button Content="Paradas"
                                            Click="OnTransportStepStopsClick" />
                                </StackPanel>
                            </ScrollViewer>

