                                        Content="↑"
                                        Tag="0,-1"
                                        Click="OnTileNavigateClick" />
                                <Button Grid.Column="2"
                                        Content="↓"
                                        Tag="0,1"
                                        Click="OnTileNavigateClick" />
                                <Button Grid.Column="3"
                                        Content="→"
                                        Tag="1,0"
                                        Click="OnTileNavigateClick" />
                            </Grid>

