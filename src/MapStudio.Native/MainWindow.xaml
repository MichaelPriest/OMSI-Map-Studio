                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="0.1" />
                                    <NumberBox x:Name="InspectorGradientEndBox"
                                               Grid.Column="1"
                                               Header="Inclinação final (%)"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="0.1" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="InspectorPreviousSplineIdBox"
                                               Grid.Column="0"
                                               Header="Anterior ID"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" />
                                    <NumberBox x:Name="InspectorNextSplineIdBox"
                                               Grid.Column="1"
                                               Header="Próxima ID"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" />
                                </Grid>
                                <Button x:Name="LevelSplineToTerrainButton"
                                        Content="Ajustar ao terreno"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Click="OnLevelSelectedSplineToTerrainClick" />
                                <Button x:Name="SaveSplineLinksButton"
                                        Content="Salvar vínculos"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Click="OnSaveSplineLinksClick" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="EditSplineAdvancedButton"
                                            Grid.Column="0"
                                            Content="Cant / Mirror..."
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Click="OnEditSplineAdvancedClick" />
                                    <Button x:Name="CompleteToSplineButton"
                                            Grid.Column="1"
                                            Content="Complete to..."
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Click="OnCompleteToSplineClick" />
                                </Grid>
                                <Button x:Name="ExportSplineXButton"
                                        Content="Spline Export (.x)..."
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Click="OnExportSplineXClick" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="InspectorSelectionActionsCard"
                                Visibility="Collapsed"
                                Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <StackPanel Spacing="7">
                                <TextBlock Text="Ações"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource MapStudioTextPrimaryBrush}" />
                                <Button x:Name="ApplyInspectorButton"
                                        Content="Aplicar valores"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Click="OnApplyInspectorClick" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="DuplicateSelectionButton"
                                            Grid.Column="0"
                                            Content="Colocar cópia"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Click="OnDuplicateSelectionClick" />
                                    <Button x:Name="DeleteSelectionButton"
                                            Grid.Column="1"
                                            Content="Excluir"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Click="OnDeleteSelectionClick" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="InspectorTerrainFields"
                                Visibility="Collapsed"
                                Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Terreno"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource MapStudioTextPrimaryBrush}" />
                                <Button x:Name="PickTerrainPointButton"
                                        Content="Escolher ponto no mapa"
                                        HorizontalAlignment="Stretch"
                                        Click="OnPickTerrainPointClick" />
                                <TextBlock x:Name="TerrainPointText"
                                           Text="Nenhum ponto selecionado."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{ThemeResource MapStudioTextSecondaryBrush}" />
                                <NumberBox x:Name="TerrainTargetHeightBox"
                                           Header="Altura alvo (m)"
                                           SpinButtonPlacementMode="Compact"
                                           SmallChange="0.25" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="TerrainBrushRadiusBox"
                                               Grid.Column="0"
                                               Header="Raio (m)"
                                               Value="20"
                                               Minimum="0.25"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" />
                                    <NumberBox x:Name="TerrainBrushFeatherBox"
                                               Grid.Column="1"
                                               Header="Suavização (0–1)"
                                               Value="0.25"
                                               Minimum="0"
                                               Maximum="1"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="0.05" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Spacing="2">
                                        <TextBlock Text="Raio do pincel"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                                        <Slider x:Name="TerrainBrushRadiusSlider"
                                                Minimum="0.25"
                                                Maximum="250"
                                                StepFrequency="0.25"
                                                Value="{Binding Value, ElementName=TerrainBrushRadiusBox, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Spacing="2">
                                        <TextBlock Text="Suavização"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                                        <Slider x:Name="TerrainBrushFeatherSlider"
                                                Minimum="0"
                                                Maximum="1"
                                                StepFrequency="0.01"
                                                Value="{Binding Value, ElementName=TerrainBrushFeatherBox, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                                <Button x:Name="ApplyTerrainLevelButton"
                                        Content="Aplicar nivelamento"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Click="OnApplyTerrainLevelClick" />
                                <NumberBox x:Name="TerrainBrushDeltaBox"
                                           Header="Força elevar/abaixar (m)"
                                           Value="1"
                                           Minimum="0.05"
                                           Maximum="100"
                                           SpinButtonPlacementMode="Compact"
                                           SmallChange="0.25" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Intensidade do pincel"
                                               FontSize="10"
                                               Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                                    <Slider x:Name="TerrainBrushDeltaSlider"
                                            Minimum="0.05"
                                            Maximum="100"
                                            StepFrequency="0.05"
                                            Value="{Binding Value, ElementName=TerrainBrushDeltaBox, Mode=TwoWay}" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RaiseTerrainButton"
                                            Grid.Column="0"
                                            Content="Elevar"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Click="OnRaiseTerrainClick" />
                                    <Button x:Name="LowerTerrainButton"
                                            Grid.Column="1"
                                            Content="Abaixar"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            Click="OnLowerTerrainClick" />
                                </Grid>
                                <TextBlock Text="Textura / material"
                                           Margin="0,5,0,0"
                                           FontWeight="SemiBold" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="TerrainPaintLayerBox"
                                               Grid.Column="0"
                                               Header="Groundtex"
                                               Value="1"
                                               Minimum="1"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="1" />
                                    <NumberBox x:Name="TerrainPaintAlphaBox"
                                               Grid.Column="1"
                                               Header="Alpha 0–255"
                                               Value="255"
                                               Minimum="0"
                                               Maximum="255"
                                               SpinButtonPlacementMode="Compact"
                                               SmallChange="16" />
                                </Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Mistura da textura"
                                               FontSize="10"
                                               Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                                    <Slider x:Name="TerrainPaintAlphaSlider"
                                            Minimum="0"
                                            Maximum="255"
                                            StepFrequency="1"
                                            Value="{Binding Value, ElementName=TerrainPaintAlphaBox, Mode=TwoWay}" />
                                </StackPanel>
                                <Button x:Name="ApplyTerrainPaintButton"
                                        Content="Pintar textura no ponto"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False"
                                        Click="OnApplyTerrainPaintClick" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Seleção e edição compartilham o estado nativo do viewport e do ID Buffer."
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Background="{ThemeResource MapStudioChromeBackgroundBrush}"
              Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Text="Runtime nativo pronto para inicialização" />

            <TextBlock x:Name="BuildVersionText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="v— · WinUI 3 · Direct3D 11 · .NET 10"
                       Foreground="{ThemeResource MapStudioTextMutedBrush}" />
        </Grid>
    </Grid>
</Window>
