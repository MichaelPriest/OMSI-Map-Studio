                                          Visibility="Collapsed"
                                          ColumnSpacing="6"
                                          RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <NumberBox x:Name="EasyRoadStartXBox"
                                                   Grid.Row="0"
                                                   Grid.Column="0"
                                                   Header="Início X"
                                                   SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="EasyRoadStartZBox"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Header="Início Z"
                                                   SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="EasyRoadEndXBox"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   Header="Fim X"
                                                   SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="EasyRoadEndZBox"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Header="Fim Z"
                                                   SpinButtonPlacementMode="Compact" />
                                        <Button Grid.Row="2"
                                                Grid.Column="0"
                                                Content="Aplicar pontos"
                                                HorizontalAlignment="Stretch"
                                                Click="OnApplyEasyRoadPointsClick" />
                                        <Button Grid.Row="2"
                                                Grid.Column="1"
                                                Content="Confirmar via"
                                                HorizontalAlignment="Stretch"
                                                Click="OnConfirmEasyRoadClick" />
                                        <Button Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Content="Ajustar curva no mapa"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="Use o cursor como alça lateral da via; clique para fixar a curvatura."
                                                Click="OnAdjustEasyRoadCurveOnMapClick" />
                                    </Grid>
                                    <TextBlock Text="Estrada fácil: marque início e fim; use Ajustar curva no mapa para mover a alça visual, ou ajuste o offset numericamente; depois confirme. Offset 0 = reta."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#7895AD" />
                                    <CheckBox x:Name="SplineCurveCheckBox"
                                              Content="Curva manual (3 cliques)" />
                                    <CheckBox x:Name="SplineContinuousCheckBox"
                                              Content="Continuar segmentos"
                                              IsChecked="True" />
                                    <CheckBox x:Name="SplineEndpointSnapCheckBox"
                                              Content="Encaixar endpoints"
                                              IsChecked="True" />
                                    <NumberBox x:Name="SplineEndpointSnapDistanceBox"
                                               Header="Distância de snap (m)"
                                               Minimum="0.5"
                                               Maximum="30"
                                               Value="5"
                                               SmallChange="0.5"
                                               SpinButtonPlacementMode="Compact" />
                                    <CheckBox x:Name="SplineAutoConnectCheckBox"
                                              Content="Conectar Previous/Next automaticamente"
                                              IsChecked="True" />
                                    <NumberBox x:Name="SplineElevationOffsetBox"
                                               Header="Elevação adicional (m)"
                                               Minimum="-100"
                                               Maximum="300"
                                               Value="0"
                                               SmallChange="0.5"
                                               SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="LibraryStatusText"
                                       Grid.Row="2"
                                       Text="Índice de assets não carregado."
