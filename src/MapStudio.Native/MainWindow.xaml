                                <ComboBoxItem Content="Trips / rotas (.ttp)" />
                                <ComboBoxItem Content="Stops / paradas (Busstops.cfg)" />
                                <ComboBoxItem Content="StationLinks (StnLinks.cfg)" />
                                <ComboBoxItem Content="Lines / Tours (.ttl)" />
