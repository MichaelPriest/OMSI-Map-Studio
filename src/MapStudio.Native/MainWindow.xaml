<Window
    x:Class="MapStudio.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MapStudio.Native.Controls"
    Title="OMSI Map Studio — World Creator">

    <Grid x:Name="MainRoot"
          Background="#08131D">
        <Grid.Resources>
            <SolidColorBrush x:Key="MapToolDefaultBackgroundBrush"
                             Color="#132A39" />
            <SolidColorBrush x:Key="MapToolDefaultBorderBrush"
                             Color="#315064" />
            <SolidColorBrush x:Key="MapToolActiveBackgroundBrush"
                             Color="#185B78" />
            <SolidColorBrush x:Key="MapToolActiveBorderBrush"
                             Color="#75D9FF" />
            <SolidColorBrush x:Key="ExplorerModeDefaultBackgroundBrush"
                             Color="#102633" />
            <SolidColorBrush x:Key="ExplorerModeDefaultBorderBrush"
                             Color="#27495A" />
            <SolidColorBrush x:Key="ExplorerModeActiveBackgroundBrush"
                             Color="#185B78" />
            <SolidColorBrush x:Key="ExplorerModeActiveBorderBrush"
                             Color="#75D9FF" />
            <Style x:Key="MapToolButtonStyle"
                   TargetType="Button">
                <Setter Property="Width"
                        Value="76" />
                <Setter Property="Height"
                        Value="64" />
                <Setter Property="Padding"
                        Value="5" />
                <Setter Property="Background"
                        Value="{StaticResource MapToolDefaultBackgroundBrush}" />
                <Setter Property="BorderBrush"
                        Value="{StaticResource MapToolDefaultBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="9" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
            </Style>
            <Style x:Key="EditorToolbarButtonStyle"
                   TargetType="Button">
                <Setter Property="MinHeight"
                        Value="30" />
                <Setter Property="Padding"
                        Value="10,4" />
                <Setter Property="FontSize"
                        Value="11" />
                <Setter Property="Background"
                        Value="#102A39" />
                <Setter Property="BorderBrush"
                        Value="#315064" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="6" />
            </Style>
            <Style x:Key="ExplorerModeButtonStyle"
                   TargetType="Button">
                <Setter Property="MinHeight"
                        Value="42" />
                <Setter Property="Padding"
                        Value="6,5" />
                <Setter Property="FontSize"
                        Value="10.5" />
                <Setter Property="Background"
                        Value="{StaticResource ExplorerModeDefaultBackgroundBrush}" />
                <Setter Property="BorderBrush"
                        Value="{StaticResource ExplorerModeDefaultBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="7" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
            </Style>
            <Style x:Key="MapToolGroupBadgeStyle"
                   TargetType="Border">
                <Setter Property="Width"
                        Value="48" />
                <Setter Property="Height"
                        Value="64" />
                <Setter Property="Margin"
                        Value="3,0" />
                <Setter Property="Padding"
                        Value="5" />
                <Setter Property="Background"
                        Value="#0D2330" />
                <Setter Property="BorderBrush"
                        Value="#294A5D" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11"
                                 Invoked="OnFullscreenAcceleratorInvoked" />
            <KeyboardAccelerator Key="W"
                                 Invoked="OnMoveAcceleratorInvoked" />
            <KeyboardAccelerator Key="E"
                                 Invoked="OnRotateAcceleratorInvoked" />
            <KeyboardAccelerator Key="S"
                                 Modifiers="Control"
                                 Invoked="OnSaveAcceleratorInvoked" />
            <KeyboardAccelerator Key="Z"
                                 Modifiers="Control"
                                 Invoked="OnUndoAcceleratorInvoked" />
            <KeyboardAccelerator Key="Y"
                                 Modifiers="Control"
                                 Invoked="OnRedoAcceleratorInvoked" />
            <KeyboardAccelerator Key="Escape"
                                 Invoked="OnEscapeAcceleratorInvoked" />
            <KeyboardAccelerator Key="Delete"
                                 Invoked="OnDeleteAcceleratorInvoked" />
            <KeyboardAccelerator Key="D"
                                 Modifiers="Control"
                                 Invoked="OnDuplicateAcceleratorInvoked" />
            <KeyboardAccelerator Key="F"
                                 Invoked="OnFocusSelectionAcceleratorInvoked" />
            <KeyboardAccelerator Key="N"
                                 Invoked="OnSnapAcceleratorInvoked" />
            <KeyboardAccelerator Key="T"
                                 Invoked="OnTerrainVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="G"
                                 Invoked="OnGridVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="O"
                                 Invoked="OnObjectsVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="L"
                                 Invoked="OnSplinesVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="P"
                                 Invoked="OnSplineProfilesVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="Q"
                                 Invoked="OnSelectAllAcceleratorInvoked" />
            <KeyboardAccelerator Key="Home"
                                 Invoked="OnFitSceneAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number1"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionAllAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number2"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionObjectsAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number3"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionSplinesAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number4"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionTerrainAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number1"
                                 Invoked="OnPerspectiveAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number2"
                                 Invoked="OnTopAcceleratorInvoked" />
            <KeyboardAccelerator Key="R"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="C"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="O"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="B"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="G"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="Y"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="T"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="A"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid x:Name="DesktopChromePanel"
              Grid.Row="0"
              Background="#06111A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="8,4,10,4"
                    Padding="12,5"
                    Background="#0B2230"
                    BorderBrush="#24485C"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal"
                            Spacing="9">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="7"
                            Background="#12384C">
                        <TextBlock Text="M"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#B9EDFF" />
                    </Border>
                    <StackPanel VerticalAlignment="Center"
                                Spacing="-2">
                        <TextBlock Text="MAP STUDIO"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#EAF7FC" />
                        <TextBlock Text="WORLD CREATOR"
                                   FontSize="9"
                                   CharacterSpacing="110"
                                   Foreground="#72B8D6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <MenuBar Grid.Row="0"
                     Grid.Column="1">
                <MenuBarItem Title="Arquivo">
                    <MenuFlyoutItem
                        Text="Workspace Map Studio"
                        Click="OnOpenWorkspaceClick" />
                    <MenuFlyoutItem
                        Text="Novo mapa..."
                        Click="OnCreateStandaloneMapClick" />
                    <MenuFlyoutItem
                        Text="Importar mapa existente..."
                        Click="OnImportStandaloneMapClick" />
                    <MenuFlyoutItem
                        Text="Adicionar pasta de itens..."
                        Click="OnAddAssetFolderClick" />
                    <MenuFlyoutItem
                        Text="Exportar mapa como pacote OMSI..."
                        Click="OnExportWorkspaceOmsiPackageClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Abrir OMSI..."
                        Click="OnOpenOmsiClick" />
                    <MenuFlyoutItem
                        x:Name="OpenMapMenuItem"
                        Text="Abrir mapa do catálogo..."
                        IsEnabled="False"
                        Click="OnOpenMapCatalogClick" />
                    <MenuFlyoutItem
                        x:Name="RefreshMapCatalogMenuItem"
                        Text="Atualizar catálogo de mapas"
                        IsEnabled="False"
                        Click="OnRefreshMapCatalogClick" />
                    <MenuFlyoutItem
                        Text="Abrir pasta de mapa..."
                        Click="OnOpenMapClick" />
                </MenuBarItem>
                <MenuBarItem Title="Editar">
                    <MenuFlyoutItem
                        x:Name="UndoConstructionMenuItem"
                        Text="Desfazer construção"
                        IsEnabled="False"
                        Click="OnUndoConstructionClick" />
                    <MenuFlyoutItem
                        x:Name="RedoConstructionMenuItem"
                        Text="Refazer construção"
                        IsEnabled="False"
                        Click="OnRedoConstructionClick" />
                </MenuBarItem>
                <MenuBarItem Title="Visualizar">
                    <MenuFlyoutItem
                        Text="Tela cheia (F11)"
                        Click="OnFullscreenClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Perspectiva"
                        Click="OnPerspectiveViewClick" />
                    <MenuFlyoutItem
                        Text="Vista superior"
                        Click="OnTopViewClick" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowTerrainMenuItem"
                        Text="Terreno"
                        IsChecked="True"
                        Click="OnSceneVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowTerrainPaintMenuItem"
                        Text="Pintura do terreno"
                        IsChecked="True"
                        IsEnabled="False"
                        Click="OnTerrainPaintVisibilityClick" />
                    <MenuFlyoutSubItem
                        x:Name="TerrainLayersMenuItem"
                        Text="Camadas pintadas"
                        IsEnabled="False">
                        <MenuFlyoutItem
                            Text="Abra um mapa..."
                            IsEnabled="False" />
                    </MenuFlyoutSubItem>
                    <ToggleMenuFlyoutItem
                        x:Name="ShowObjectsMenuItem"
                        Text="Objetos"
                        IsChecked="True"
                        Click="OnSceneVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowSplinesMenuItem"
                        Text="Splines"
                        IsChecked="True"
                        Click="OnSceneVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowGridMenuItem"
                        Text="Grade"
                        IsChecked="True"
                        Click="OnGridVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowSplineProfilesMenuItem"
                        Text="Perfis reais das splines"
                        IsChecked="True"
                        Click="OnSplineProfilesVisibilityClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Alternar Explorer"
                        Click="OnToggleExplorerClick" />
                    <MenuFlyoutItem
                        Text="Alternar Inspector"
                        Click="OnToggleInspectorClick" />
                </MenuBarItem>
                <MenuBarItem Title="Mapa">
                    <MenuFlyoutItem
                        x:Name="FullMapModeMenuItem"
                        Text="Mapa completo"
                        Click="OnFullMapModeClick" />
                    <MenuFlyoutItem
                        x:Name="PerformanceMapModeMenuItem"
                        Text="Modo desempenho 3×3"
                        Click="OnPerformanceMapModeClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Gerenciador de tiles..."
                        Click="OnTileManagerClick" />
                    <MenuFlyoutItem
                        Text="Criar tile..."
                        Click="OnCreateMapTileClick" />
                    <MenuFlyoutItem
                        Text="Excluir tile ativo..."
                        Click="OnDeleteActiveMapTileClick" />
                    <MenuFlyoutItem
                        Text="Criar mapa real por coordenadas..."
                        Click="OnCreateCoordinateMapClick" />
                    <MenuFlyoutItem
                        Text="Georreferência do mapa..."
                        Click="OnEditMapGeoreferenceClick" />
                    <MenuFlyoutItem
                        Text="Aplicar elevação Google no tile ativo..."
                        Click="OnGoogleElevationClick" />
                    <MenuFlyoutItem
                        Text="Importar grade local de elevação no tile ativo..."
                        Click="OnImportLocalElevationGridClick" />
                    <MenuFlyoutItem
                        Text="Carregar referência Google sobre o terreno..."
                        Click="OnGoogleMapReferenceClick" />
                    <MenuFlyoutItem
                        Text="Remover referência Google"
                        Click="OnClearGoogleMapReferenceClick" />
                </MenuBarItem>
                <MenuBarItem Title="Ferramentas">
                    <MenuFlyoutItem
                        Text="Substituir dependência SCO/SLI..."
                        Click="OnReplaceDependencyClick" />
                    <MenuFlyoutItem
                        Text="Restaurar backup do Map Studio..."
                        Click="OnRestoreBackupClick" />
                    <MenuFlyoutItem
                        Text="Inspecionar attachments..."
                        Click="OnInspectAttachmentsClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Construction Sets..."
                        Click="OnConstructionSetsClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Building Studio..."
                        Click="OnBuildingStudioClick" />
                    <MenuFlyoutItem
                        Text="Importar edifícios OSM..."
                        Click="OnImportOsmBuildingsClick" />
                    <MenuFlyoutItem
                        Text="Importar vegetação OSM..."
                        Click="OnImportOsmVegetationClick" />
                    <MenuFlyoutItem
                        Text="Instalar/atualizar Road Kit..."
                        Click="OnInstallRoadKitClick" />
                    <MenuFlyoutItem
                        Text="Criador de pontes..."
                        Click="OnCreateBridgeClick" />
                    <MenuFlyoutItem
                        Text="Criador de túneis..."
                        Click="OnCreateTunnelClick" />
                    <MenuFlyoutSubItem
                        Text="Gerador procedural de vias">
                        <MenuFlyoutItem
                            Text="Analisar referência Google com IA..."
                            Click="OnAnalyzeGoogleRoadReferenceWithAiClick" />
                        <MenuFlyoutItem
                            Text="Importar GeoJSON georreferenciado..."
                            Click="OnImportProceduralRoadGeoJsonClick" />
                        <MenuFlyoutItem
                            Text="Importar OSM XML georreferenciado..."
                            Click="OnImportProceduralRoadOsmClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Text="Iniciar nova linha..."
                            Click="OnStartProceduralRoadTraceClick" />
                        <MenuFlyoutItem
                            x:Name="FinishProceduralRoadTraceMenuItem"
                            Text="Finalizar linha atual"
                            IsEnabled="False"
                            Click="OnFinishProceduralRoadTraceClick" />
                        <MenuFlyoutItem
                            x:Name="AnalyzeProceduralRoadGraphMenuItem"
                            Text="Analisar grafo/interseções..."
                            IsEnabled="False"
                            Click="OnAnalyzeProceduralRoadGraphClick" />
                        <MenuFlyoutItem
                            x:Name="ClearProceduralRoadGraphMenuItem"
                            Text="Limpar traçado"
                            IsEnabled="False"
                            Click="OnClearProceduralRoadGraphClick" />
                    </MenuFlyoutSubItem>
                </MenuBarItem>
                <MenuBarItem Title="IA">
                    <MenuFlyoutItem
                        Text="Configurar provedores..."
                        Click="OnAiProvidersClick" />
                </MenuBarItem>
                <MenuBarItem Title="Conta">
                    <MenuFlyoutItem
                        Text="Assinatura e licença..."
                        Click="OnCommercialStatusClick" />
                </MenuBarItem>
                <MenuBarItem Title="Ajuda" />
            </MenuBar>

            <ScrollViewer
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalScrollMode="Auto"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled">
                <Border Margin="8,2,8,6"
                        Padding="8,6"
                        Background="#091B27"
                        BorderBrush="#1E4053"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    HorizontalAlignment="Left">
                            <Button x:Name="SaveChangesButton"
                                    Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="Salvar"
                                    IsEnabled="False"
                                    Click="OnSaveChangesClick" />
                            <Button x:Name="UndoButton"
                                    Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="Desfazer"
                                    IsEnabled="False"
                                    Click="OnUndoClick" />
                            <Button x:Name="RedoButton"
                                    Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="Refazer"
                                    IsEnabled="False"
                                    Click="OnRedoClick" />
                            <Rectangle Width="1"
                                       Height="24"
                                       Fill="#28495B"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="F11"
                                    ToolTipService.ToolTip="Modo Criador em tela cheia"
                                    Click="OnFullscreenClick" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="10,4"
                                Background="#102C3E"
                                BorderBrush="#315064"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#55D96B"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="RootModeText"
                                           Text="WORKSPACE"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#9FE4FF"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Map Studio"
                                           FontSize="11"
                                           Foreground="#B6CBD8"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    HorizontalAlignment="Right">
                            <CheckBox x:Name="NightPreviewCheckBox"
                                      Content="Dia/noite"
                                      VerticalAlignment="Center"
                                      Checked="OnNightPreviewChecked"
                                      Unchecked="OnNightPreviewUnchecked" />
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="Workspace"
                                    ToolTipService.ToolTip="Voltar ao Workspace Map Studio"
                                    Click="OnOpenWorkspaceClick" />
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="Abrir OMSI"
                                    ToolTipService.ToolTip="Usar opcionalmente mapas e itens da instalação do OMSI"
                                    Click="OnOpenOmsiClick" />
                            <Button x:Name="OpenMapButton"
                                    Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="Mapas"
                                    IsEnabled="False"
                                    Click="OnOpenMapCatalogClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="WorkspaceGrid"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn"
                                  Width="340" />
                <ColumnDefinition x:Name="ExplorerSplitterColumn"
                                  Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitterColumn"
                                  Width="6" />
                <ColumnDefinition x:Name="InspectorColumn"
                                  Width="330" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ExplorerPanel"
                    Grid.Column="0"
                    Margin="8"
                    Background="#0C2130"
                    BorderBrush="#24485C"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FullscreenExplorerTranslate" />
                </Border.RenderTransform>
                <Grid Padding="12" RowSpacing="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          ColumnSpacing="8"
                          Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="1">
                            <TextBlock Text="PROJETO"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="55" />
                            <TextBlock x:Name="ExplorerModeSubtitleText"
                                       Text="Cena e conteúdo do mapa"
                                       FontSize="11"
                                       Foreground="#799AAE" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            <Button x:Name="RefreshLibraryButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Content="↻"
                                    ToolTipService.ToolTip="Atualizar biblioteca"
                                    IsEnabled="False"
                                    Click="OnRefreshLibraryClick" />
                            <Border Width="28"
                                    Height="28"
                                    Background="#132D3D"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="Arraste para mover no F11"
                                    PointerPressed="OnExplorerFloatingDragPressed"
                                    PointerMoved="OnExplorerFloatingDragMoved"
                                    PointerReleased="OnExplorerFloatingDragReleased"
                                    PointerCanceled="OnExplorerFloatingDragReleased">
                                <TextBlock Text="⋮⋮"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#9FCBE2" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SceneExplorerModeButton"
                                Grid.Column="0"
                                Style="{StaticResource ExplorerModeButtonStyle}"
                                ToolTipService.ToolTip="Elementos presentes no mapa"
                                Click="OnSceneExplorerModeClick">
                            <StackPanel Spacing="1">
                                <TextBlock Text="◈"
                                           FontSize="14"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Cena"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="LibraryExplorerModeButton"
                                Grid.Column="1"
                                Style="{StaticResource ExplorerModeButtonStyle}"
                                ToolTipService.ToolTip="Biblioteca de itens do Workspace ou OMSI"
                                Click="OnLibraryModeClick">
                            <StackPanel Spacing="1">
                                <TextBlock Text="▦"
                                           FontSize="14"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Assets"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="MapExplorerModeButton"
                                Grid.Column="2"
                                Style="{StaticResource ExplorerModeButtonStyle}"
                                ToolTipService.ToolTip="Tiles, coordenadas e ferramentas globais"
                                Click="OnTileManagerClick">
                            <StackPanel Spacing="1">
                                <TextBlock Text="⌖"
                                           FontSize="14"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Mapa"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TransportExplorerModeButton"
                                Grid.Column="3"
                                Style="{StaticResource ExplorerModeButtonStyle}"
                                ToolTipService.ToolTip="Tracks, Trips, Stops, StationLinks e Lines/Tours"
                                Click="OnToolTransportClick">
                            <StackPanel Spacing="1">
                                <TextBlock Text="↔"
                                           FontSize="14"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Transporte"
                                           FontSize="9.5"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2"
                          ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ExplorerSearchBox"
                                 Grid.Column="0"
                                 PlaceholderText="Buscar na área atual..."
                                 TextChanged="OnExplorerSearchTextChanged" />

                        <Button Grid.Column="1"
                                Width="34"
                                Content="⌕"
                                ToolTipService.ToolTip="Focar seleção atual"
                                Click="OnFocusSelectionClick" />
                    </Grid>

                    <Border Grid.Row="3"
                            Background="#0A1B27"
                            BorderBrush="#24485C"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="9">
                        <StackPanel Spacing="5">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
