<Window
    x:Class="MapStudio.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MapStudio.Native.Controls"
    Title="OMSI Map Studio Native">

    <Grid x:Name="MainRoot"
          Background="#08131D">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11"
                                 Invoked="OnFullscreenAcceleratorInvoked" />
            <KeyboardAccelerator Key="W"
                                 Invoked="OnMoveAcceleratorInvoked" />
            <KeyboardAccelerator Key="E"
                                 Invoked="OnRotateAcceleratorInvoked" />
            <KeyboardAccelerator Key="S"
                                 Modifiers="Control"
                                 Invoked="OnSaveAcceleratorInvoked" />
            <KeyboardAccelerator Key="Z"
                                 Modifiers="Control"
                                 Invoked="OnUndoAcceleratorInvoked" />
            <KeyboardAccelerator Key="Y"
                                 Modifiers="Control"
                                 Invoked="OnRedoAcceleratorInvoked" />
            <KeyboardAccelerator Key="Escape"
                                 Invoked="OnEscapeAcceleratorInvoked" />
            <KeyboardAccelerator Key="Delete"
                                 Invoked="OnDeleteAcceleratorInvoked" />
            <KeyboardAccelerator Key="D"
                                 Modifiers="Control"
                                 Invoked="OnDuplicateAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="#071621">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <MenuBar>
                <MenuBarItem Title="Arquivo">
                    <MenuFlyoutItem
                        Text="Abrir OMSI..."
                        Click="OnOpenOmsiClick" />
                    <MenuFlyoutItem
                        x:Name="OpenMapMenuItem"
                        Text="Abrir mapa..."
                        IsEnabled="False"
                        Click="OnOpenMapClick" />
                </MenuBarItem>
                <MenuBarItem Title="Editar" />
                <MenuBarItem Title="Visualizar">
                    <MenuFlyoutItem
                        Text="Tela cheia (F11)"
                        Click="OnFullscreenClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Alternar Explorer"
                        Click="OnToggleExplorerClick" />
                    <MenuFlyoutItem
                        Text="Alternar Inspector"
                        Click="OnToggleInspectorClick" />
                </MenuBarItem>
                <MenuBarItem Title="Mapa" />
                <MenuBarItem Title="Ferramentas" />
                <MenuBarItem Title="Ajuda" />
            </MenuBar>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                Margin="8,4">
                <Button
                    x:Name="SaveChangesButton"
                    Content="Salvar alterações"
                    IsEnabled="False"
                    Click="OnSaveChangesClick" />
                <Button
                    x:Name="UndoButton"
                    Content="Desfazer"
                    IsEnabled="False"
                    Click="OnUndoClick" />
                <Button
                    x:Name="RedoButton"
                    Content="Refazer"
                    IsEnabled="False"
                    Click="OnRedoClick" />
                <Button
                    x:Name="SnapButton"
                    Content="Snap: off"
                    Click="OnSnapClick" />
                <Button
                    Content="Mover"
                    ToolTipService.ToolTip="Gizmo mover (W)"
                    Click="OnMoveGizmoClick" />
                <Button
                    Content="Rotacionar"
                    ToolTipService.ToolTip="Gizmo rotacionar (E)"
                    Click="OnRotateGizmoClick" />
                <Button
                    Content="Abrir OMSI"
                    Click="OnOpenOmsiClick" />
                <Button
                    x:Name="OpenMapButton"
                    Content="Abrir mapa"
                    IsEnabled="False"
                    Click="OnOpenMapClick" />
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn"
                                  Width="300" />
                <ColumnDefinition x:Name="ExplorerSplitterColumn"
                                  Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitterColumn"
                                  Width="6" />
                <ColumnDefinition x:Name="InspectorColumn"
                                  Width="320" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ExplorerPanel"
                    Grid.Column="0"
                    Margin="8"
                    Background="#0C2130"
                    CornerRadius="8">
                <Grid Padding="14" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Explorer"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="6">
                        <Button Content="Cena"
                                Click="OnSceneExplorerModeClick" />
                        <Button Content="Biblioteca"
                                Click="OnLibraryModeClick" />
                        <Button x:Name="RefreshLibraryButton"
                                Content="Atualizar"
                                IsEnabled="False"
                                Click="OnRefreshLibraryClick" />
                    </StackPanel>

                    <TextBox x:Name="ExplorerSearchBox"
                             Grid.Row="2"
                             PlaceholderText="Buscar..."
                             TextChanged="OnExplorerSearchTextChanged" />

                    <StackPanel Grid.Row="3"
                                Spacing="3">
                        <TextBlock x:Name="RootText"
                                   Text="Nenhuma instalação OMSI selecionada."
                                   TextWrapping="Wrap"
                                   Foreground="#9FB5C5" />
                        <TextBlock x:Name="MapText"
                                   Text="Nenhum mapa aberto."
                                   TextWrapping="Wrap"
                                   Foreground="#9FB5C5" />
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <ListView x:Name="ExplorerListView"
                                  SelectionMode="Single"
                                  DisplayMemberPath="DisplayText"
                                  SelectionChanged="OnExplorerSelectionChanged"
                                  DoubleTapped="OnExplorerDoubleTapped" />

                        <Grid x:Name="AssetLibraryPanel"
                              Visibility="Collapsed"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ComboBox x:Name="LibraryKindComboBox"
                                      Grid.Row="0"
                                      SelectedIndex="0"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnLibraryKindSelectionChanged">
                                <ComboBoxItem Content="Todos" />
                                <ComboBoxItem Content="Objetos SCO" />
                                <ComboBoxItem Content="Splines SLI" />
                                <ComboBoxItem Content="Modelos" />
                                <ComboBoxItem Content="Texturas" />
                            </ComboBox>

                            <StackPanel Grid.Row="1"
                                        Spacing="6">
                                <Button x:Name="PlaceAssetButton"
                                        Content="Posicionar no mapa"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        Click="OnPlaceAssetClick" />
                                <CheckBox x:Name="SplineCurveCheckBox"
                                          Content="Curva (3 cliques)"
                                          Visibility="Collapsed" />
                                <CheckBox x:Name="SplineContinuousCheckBox"
                                          Content="Continuar segmentos"
                                          IsChecked="True"
                                          Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock x:Name="LibraryStatusText"
                                       Grid.Row="2"
                                       Text="Índice de assets não carregado."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#9FB5C5" />

                            <ListView x:Name="AssetLibraryListView"
                                      Grid.Row="3"
                                      SelectionMode="Single"
                                      DisplayMemberPath="RelativePath"
                                      SelectionChanged="OnAssetLibrarySelectionChanged"
                                      DoubleTapped="OnAssetLibraryDoubleTapped" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ExplorerSplitter"
                    Grid.Column="1"
                    Margin="1,8"
                    Background="#173347"
                    CornerRadius="3"
                    PointerPressed="OnPanelSplitterPointerPressed"
                    PointerMoved="OnPanelSplitterPointerMoved"
                    PointerReleased="OnPanelSplitterPointerReleased" />

            <controls:NativeViewport
                x:Name="Viewport"
                Grid.Column="2"
                Margin="0,8" />

            <Border x:Name="InspectorSplitter"
                    Grid.Column="3"
                    Margin="1,8"
                    Background="#173347"
                    CornerRadius="3"
                    PointerPressed="OnPanelSplitterPointerPressed"
                    PointerMoved="OnPanelSplitterPointerMoved"
                    PointerReleased="OnPanelSplitterPointerReleased" />

            <Border x:Name="InspectorPanel"
                    Grid.Column="4"
                    Margin="8"
                    Background="#0C2130"
                    CornerRadius="8">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="14" Spacing="10">
                        <TextBlock Text="Inspector"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectionText"
                                   Text="Sem seleção"
                                   FontSize="14"
                                   Foreground="#9FB5C5" />
                        <TextBlock x:Name="InspectorTypeText"
                                   Text="Tipo: —"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="InspectorAssetText"
                                   Text="Arquivo: —"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="#B9CAD6" />
                        <TextBlock x:Name="InspectorTileText"
                                   Text="Tile: —"
                                   FontSize="13"
                                   Foreground="#B9CAD6" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <NumberBox x:Name="InspectorXBox"
                                       Grid.Column="0"
                                       Header="X"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25" />
                            <NumberBox x:Name="InspectorYBox"
                                       Grid.Column="1"
                                       Header="Y"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25" />
                            <NumberBox x:Name="InspectorZBox"
                                       Grid.Column="2"
                                       Header="Z"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25" />
                        </Grid>

                        <NumberBox x:Name="InspectorRotationBox"
                                   Header="Rotação"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="5" />

                        <StackPanel x:Name="InspectorObjectFields"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <NumberBox x:Name="InspectorPitchBox"
                                       Header="Pitch"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="5" />
                            <NumberBox x:Name="InspectorBankBox"
                                       Header="Bank"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="5" />
                        </StackPanel>

                        <StackPanel x:Name="InspectorSplineFields"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <NumberBox x:Name="InspectorLengthBox"
                                       Header="Comprimento"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25"
                                       Minimum="0" />
                            <NumberBox x:Name="InspectorRadiusBox"
                                       Header="Raio"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25" />
                            <NumberBox x:Name="InspectorGradientStartBox"
                                       Header="Gradiente inicial (%)"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.1" />
                            <NumberBox x:Name="InspectorGradientEndBox"
                                       Header="Gradiente final (%)"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.1" />
                        </StackPanel>

                        <Button x:Name="ApplyInspectorButton"
                                Content="Aplicar valores"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="OnApplyInspectorClick" />

                        <Button x:Name="DuplicateSelectionButton"
                                Content="Colocar cópia"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="OnDuplicateSelectionClick" />

                        <Button x:Name="DeleteSelectionButton"
                                Content="Excluir selecionado"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="OnDeleteSelectionClick" />

                        <TextBlock Text="Seleção e edição usam o mesmo estado nativo do viewport e do ID Buffer."
                                   TextWrapping="Wrap"
                                   Foreground="#7FA6BF" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Background="#061018"
              Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Text="Runtime nativo pronto para inicialização" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="WinUI 3 · Direct3D 11 · .NET 10"
                       Foreground="#7FA6BF" />
        </Grid>
    </Grid>
</Window>
