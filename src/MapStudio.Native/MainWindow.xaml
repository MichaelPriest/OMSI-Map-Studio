<Window
    x:Class="MapStudio.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MapStudio.Native.Controls"
    Title="OMSI Map Studio Native">

    <Grid x:Name="MainRoot"
          Background="#08131D">
        <Grid.Resources>
            <Style x:Key="MapToolButtonStyle"
                   TargetType="Button">
                <Setter Property="Width"
                        Value="76" />
                <Setter Property="Height"
                        Value="64" />
                <Setter Property="Padding"
                        Value="5" />
                <Setter Property="Background"
                        Value="#132A39" />
                <Setter Property="BorderBrush"
                        Value="#315064" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="9" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11"
                                 Invoked="OnFullscreenAcceleratorInvoked" />
            <KeyboardAccelerator Key="W"
                                 Invoked="OnMoveAcceleratorInvoked" />
            <KeyboardAccelerator Key="E"
                                 Invoked="OnRotateAcceleratorInvoked" />
            <KeyboardAccelerator Key="S"
                                 Modifiers="Control"
                                 Invoked="OnSaveAcceleratorInvoked" />
            <KeyboardAccelerator Key="Z"
                                 Modifiers="Control"
                                 Invoked="OnUndoAcceleratorInvoked" />
            <KeyboardAccelerator Key="Y"
                                 Modifiers="Control"
                                 Invoked="OnRedoAcceleratorInvoked" />
            <KeyboardAccelerator Key="Escape"
                                 Invoked="OnEscapeAcceleratorInvoked" />
            <KeyboardAccelerator Key="Delete"
                                 Invoked="OnDeleteAcceleratorInvoked" />
            <KeyboardAccelerator Key="D"
                                 Modifiers="Control"
                                 Invoked="OnDuplicateAcceleratorInvoked" />
            <KeyboardAccelerator Key="F"
                                 Invoked="OnFocusSelectionAcceleratorInvoked" />
            <KeyboardAccelerator Key="N"
                                 Invoked="OnSnapAcceleratorInvoked" />
            <KeyboardAccelerator Key="T"
                                 Invoked="OnTerrainVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="G"
                                 Invoked="OnGridVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="O"
                                 Invoked="OnObjectsVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="L"
                                 Invoked="OnSplinesVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="P"
                                 Invoked="OnSplineProfilesVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="Q"
                                 Invoked="OnSelectAllAcceleratorInvoked" />
            <KeyboardAccelerator Key="Home"
                                 Invoked="OnFitSceneAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number1"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionAllAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number2"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionObjectsAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number3"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionSplinesAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number4"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionTerrainAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number1"
                                 Invoked="OnPerspectiveAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number2"
                                 Invoked="OnTopAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="#071621">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <MenuBar>
                <MenuBarItem Title="Arquivo">
                    <MenuFlyoutItem
                        Text="Abrir OMSI..."
                        Click="OnOpenOmsiClick" />
                    <MenuFlyoutItem
                        x:Name="OpenMapMenuItem"
                        Text="Abrir mapa..."
                        IsEnabled="False"
                        Click="OnOpenMapClick" />
                </MenuBarItem>
                <MenuBarItem Title="Editar" />
                <MenuBarItem Title="Visualizar">
                    <MenuFlyoutItem
                        Text="Tela cheia (F11)"
                        Click="OnFullscreenClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Perspectiva"
                        Click="OnPerspectiveViewClick" />
                    <MenuFlyoutItem
                        Text="Vista superior"
                        Click="OnTopViewClick" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowTerrainMenuItem"
                        Text="Terreno"
                        IsChecked="True"
                        Click="OnSceneVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowObjectsMenuItem"
                        Text="Objetos"
                        IsChecked="True"
                        Click="OnSceneVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowSplinesMenuItem"
                        Text="Splines"
                        IsChecked="True"
                        Click="OnSceneVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowGridMenuItem"
                        Text="Grade"
                        IsChecked="True"
                        Click="OnGridVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowSplineProfilesMenuItem"
                        Text="Perfis reais das splines"
                        IsChecked="True"
                        Click="OnSplineProfilesVisibilityClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Alternar Explorer"
                        Click="OnToggleExplorerClick" />
                    <MenuFlyoutItem
                        Text="Alternar Inspector"
                        Click="OnToggleInspectorClick" />
                </MenuBarItem>
                <MenuBarItem Title="Mapa">
                    <MenuFlyoutItem
                        x:Name="FullMapModeMenuItem"
                        Text="Mapa completo"
                        Click="OnFullMapModeClick" />
                    <MenuFlyoutItem
                        x:Name="PerformanceMapModeMenuItem"
                        Text="Modo desempenho 3×3"
                        Click="OnPerformanceMapModeClick" />
                </MenuBarItem>
                <MenuBarItem Title="Ferramentas" />
                <MenuBarItem Title="Ajuda" />
            </MenuBar>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                Margin="8,4">
                <Button
                    x:Name="SaveChangesButton"
                    Content="Salvar alterações"
                    IsEnabled="False"
                    Click="OnSaveChangesClick" />
                <Button
                    x:Name="UndoButton"
                    Content="Desfazer"
                    IsEnabled="False"
                    Click="OnUndoClick" />
                <Button
                    x:Name="RedoButton"
                    Content="Refazer"
                    IsEnabled="False"
                    Click="OnRedoClick" />
                <ComboBox
                    x:Name="SelectionFilterComboBox"
                    Width="138"
                    SelectedIndex="0"
                    ToolTipService.ToolTip="Filtro do ID Buffer de seleção">
                    <ComboBoxItem Content="Selecionar: todos" />
                    <ComboBoxItem Content="Só objetos" />
                    <ComboBoxItem Content="Só splines" />
                    <ComboBoxItem Content="Só terreno" />
                </ComboBox>
                <Button
                    Content="Enquadrar"
                    ToolTipService.ToolTip="Enquadrar mapa (Home)"
                    Click="OnFitSceneClick" />
                <Button
                    Content="Focar"
                    ToolTipService.ToolTip="Focar seleção (F)"
                    Click="OnFocusSelectionClick" />
                <Button
                    x:Name="SnapButton"
                    Content="Snap: off"
                    ToolTipService.ToolTip="Alternar snap (N)"
                    Click="OnSnapClick" />
                <CheckBox
                    x:Name="NightPreviewCheckBox"
                    Content="Noite"
                    VerticalAlignment="Center"
                    Checked="OnNightPreviewChecked"
                    Unchecked="OnNightPreviewUnchecked" />
                <Button
                    Content="Mover"
                    ToolTipService.ToolTip="Gizmo mover (W)"
                    Click="OnMoveGizmoClick" />
                <Button
                    Content="Rotacionar"
                    ToolTipService.ToolTip="Gizmo rotacionar (E)"
                    Click="OnRotateGizmoClick" />
                <Button
                    Content="Abrir OMSI"
                    Click="OnOpenOmsiClick" />
                <Button
                    x:Name="OpenMapButton"
                    Content="Abrir mapa"
                    IsEnabled="False"
                    Click="OnOpenMapClick" />
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn"
                                  Width="300" />
                <ColumnDefinition x:Name="ExplorerSplitterColumn"
                                  Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitterColumn"
                                  Width="6" />
                <ColumnDefinition x:Name="InspectorColumn"
                                  Width="320" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ExplorerPanel"
                    Grid.Column="0"
                    Margin="8"
                    Background="#0C2130"
                    CornerRadius="8">
                <Grid Padding="14" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Explorer"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="6">
                        <Button Content="Cena"
                                Click="OnSceneExplorerModeClick" />
                        <Button Content="Biblioteca"
                                Click="OnLibraryModeClick" />
                        <Button x:Name="RefreshLibraryButton"
                                Content="Atualizar"
                                IsEnabled="False"
                                Click="OnRefreshLibraryClick" />
                    </StackPanel>

                    <TextBox x:Name="ExplorerSearchBox"
                             Grid.Row="2"
                             PlaceholderText="Buscar..."
                             TextChanged="OnExplorerSearchTextChanged" />

                    <StackPanel Grid.Row="3"
                                Spacing="6">
                        <TextBlock x:Name="RootText"
                                   Text="Nenhuma instalação OMSI selecionada."
                                   TextWrapping="Wrap"
                                   Foreground="#9FB5C5" />
                        <TextBlock x:Name="MapText"
                                   Text="Nenhum mapa aberto."
                                   TextWrapping="Wrap"
                                   Foreground="#9FB5C5" />
                        <TextBlock x:Name="MapLoadModeText"
                                   Text="Carregamento: mapa completo"
                                   FontSize="12"
                                   Foreground="#7FA6BF" />

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <NumberBox x:Name="TileNavigatorXBox"
                                       Grid.Column="0"
                                       Header="Tile X"
                                       SpinButtonPlacementMode="Compact" />
                            <NumberBox x:Name="TileNavigatorYBox"
                                       Grid.Column="1"
                                       Header="Tile Y"
                                       SpinButtonPlacementMode="Compact" />
                            <Button Grid.Column="2"
                                    VerticalAlignment="Bottom"
                                    Content="Ir"
                                    Click="OnTileNavigatorGoClick" />
                        </Grid>

                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="←"
                                    Tag="-1,0"
                                    Click="OnTileNavigateClick" />
                            <Button Grid.Column="1"
                                    Content="↑"
                                    Tag="0,-1"
                                    Click="OnTileNavigateClick" />
                            <Button Grid.Column="2"
                                    Content="↓"
                                    Tag="0,1"
                                    Click="OnTileNavigateClick" />
                            <Button Grid.Column="3"
                                    Content="→"
                                    Tag="1,0"
                                    Click="OnTileNavigateClick" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <ListView x:Name="ExplorerListView"
                                  SelectionMode="Single"
                                  DisplayMemberPath="DisplayText"
                                  SelectionChanged="OnExplorerSelectionChanged"
                                  DoubleTapped="OnExplorerDoubleTapped" />

                        <Grid x:Name="AssetLibraryPanel"
                              Visibility="Collapsed"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Spacing="6">
                                <ComboBox x:Name="LibraryKindComboBox"
                                          SelectedIndex="0"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnLibraryKindSelectionChanged">
                                    <ComboBoxItem Content="Todos" />
                                    <ComboBoxItem Content="Objetos SCO" />
                                    <ComboBoxItem Content="Splines SLI" />
                                    <ComboBoxItem Content="Modelos" />
                                    <ComboBoxItem Content="Texturas" />
                                </ComboBox>

                                <ComboBox x:Name="LibraryGroupComboBox"
                                          Header="Categoria"
                                          SelectedIndex="0"
                                          HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="OnLibraryGroupSelectionChanged" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Spacing="6">
                                <Button x:Name="PlaceAssetButton"
                                        Content="Posicionar no mapa"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        Click="OnPlaceAssetClick" />

                                <StackPanel x:Name="ObjectPlacementOptionsPanel"
                                            Visibility="Collapsed"
                                            Spacing="6">
                                    <ComboBox x:Name="ConstructionPresetComboBox"
                                              Header="Preset de construção"
                                              SelectedIndex="0"
                                              SelectionChanged="OnConstructionPresetChanged">
                                        <ComboBoxItem Content="Personalizado" />
                                        <ComboBoxItem Content="Arborização de avenida" />
                                        <ComboBoxItem Content="Postes de iluminação" />
                                        <ComboBoxItem Content="Casas alinhadas" />
                                        <ComboBoxItem Content="Praça arborizada" />
                                        <ComboBoxItem Content="Grade / estacionamento" />
                                    </ComboBox>

                                    <ComboBox x:Name="ObjectPlacementModeComboBox"
                                              Header="Modo de posicionamento"
                                              SelectedIndex="0"
                                              SelectionChanged="OnObjectPlacementModeChanged">
                                        <ComboBoxItem Content="Único" />
                                        <ComboBoxItem Content="Repetir" />
                                        <ComboBoxItem Content="Linha" />
                                        <ComboBoxItem Content="Pincel / área" />
                                        <ComboBoxItem Content="Matriz" />
                                        <ComboBoxItem Content="Círculo" />
                                        <ComboBoxItem Content="Lotes" />
                                    </ComboBox>

                                    <Grid ColumnSpacing="6"
                                          RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <NumberBox x:Name="PlacementSpacingBox"
                                                   Grid.Row="0"
                                                   Grid.Column="0"
                                                   Header="Espaço (m)"
                                                   Minimum="0.5"
                                                   Maximum="100"
                                                   Value="12"
                                                   SmallChange="0.5" />
                                        <NumberBox x:Name="PlacementRadiusBox"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Header="Raio (m)"
                                                   Minimum="0.5"
                                                   Maximum="150"
                                                   Value="20"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementCountBox"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   Header="Quantidade"
                                                   Minimum="1"
                                                   Maximum="256"
                                                   Value="18"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementSetbackBox"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Header="Recuo (m)"
                                                   Minimum="-100"
                                                   Maximum="100"
                                                   Value="7"
                                                   SmallChange="0.5" />
                                        <NumberBox x:Name="PlacementRowsBox"
                                                   Grid.Row="2"
                                                   Grid.Column="0"
                                                   Header="Linhas"
                                                   Minimum="1"
                                                   Maximum="16"
                                                   Value="4"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementColumnsBox"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Header="Colunas"
                                                   Minimum="1"
                                                   Maximum="16"
                                                   Value="4"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementSpacingXBox"
                                                   Grid.Row="3"
                                                   Grid.Column="0"
                                                   Header="Espaço X"
                                                   Minimum="0.5"
                                                   Maximum="100"
                                                   Value="6"
                                                   SmallChange="0.5" />
                                        <NumberBox x:Name="PlacementSpacingZBox"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Header="Espaço Y"
                                                   Minimum="0.5"
                                                   Maximum="100"
                                                   Value="6"
                                                   SmallChange="0.5" />
                                    </Grid>

                                    <CheckBox x:Name="PlacementRandomRotationCheckBox"
                                              Content="Rotação variada" />
                                    <CheckBox x:Name="PlacementTangentCheckBox"
                                              Content="Círculo tangencial"
                                              IsChecked="True" />

                                    <TextBlock Text="Linha/Lotes: clique o início e depois o fim. Área, matriz e círculo usam o clique como centro."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#7895AD" />
                                </StackPanel>

                                <CheckBox x:Name="SplineCurveCheckBox"
                                          Content="Curva (3 cliques)"
                                          Visibility="Collapsed" />
                                <CheckBox x:Name="SplineContinuousCheckBox"
                                          Content="Continuar segmentos"
                                          IsChecked="True"
                                          Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock x:Name="LibraryStatusText"
                                       Grid.Row="2"
                                       Text="Índice de assets não carregado."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#9FB5C5" />

                            <ListView x:Name="AssetLibraryListView"
                                      Grid.Row="3"
                                      SelectionMode="Single"
                                      DisplayMemberPath="RelativePath"
                                      SelectionChanged="OnAssetLibrarySelectionChanged"
                                      DoubleTapped="OnAssetLibraryDoubleTapped" />
                        </Grid>

                        <Grid x:Name="TransportPanel"
                              Visibility="Collapsed"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox x:Name="TransportKindComboBox"
                                      Grid.Row="0"
                                      SelectedIndex="0"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnTransportKindSelectionChanged">
                                <ComboBoxItem Content="Tracks (.ttr)" />
                                <ComboBoxItem Content="Trips (.ttp)" />
                                <ComboBoxItem Content="Stops (Busstops.cfg)" />
                                <ComboBoxItem Content="StationLinks (StnLinks.cfg)" />
                                <ComboBoxItem Content="Lines/Tours (.ttl)" />
                            </ComboBox>

                            <TextBlock x:Name="TransportStatusText"
                                       Grid.Row="1"
                                       Text="Nenhum TTData carregado."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#9FB5C5" />

                            <ListView x:Name="TransportListView"
                                      Grid.Row="2"
                                      SelectionMode="Single"
                                      DisplayMemberPath="DisplayText"
                                      SelectionChanged="OnTransportSelectionChanged" />

                            <TextBlock x:Name="TransportDetailText"
                                       Grid.Row="3"
                                       Text="Selecione um item para ver detalhes."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#B7CEDC" />
                        </Grid>

                        <Grid x:Name="TrafficControlPanel"
                              Visibility="Collapsed"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Tráfego OMSI"
                                       FontSize="15"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="TrafficStatusText"
                                       Grid.Row="1"
                                       Text="Nenhum dado de tráfego carregado."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#9FB5C5" />

                            <ComboBox x:Name="TrafficViewComboBox"
                                      Grid.Row="2"
                                      SelectedIndex="0"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnTrafficViewSelectionChanged">
                                <ComboBoxItem Content="Semáforos e fases" />
                                <ComboBoxItem Content="Traffic Rules" />
                            </ComboBox>

                            <Grid Grid.Row="3">
                                <Grid x:Name="TrafficSignalsPanel"
                                      RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ListView x:Name="TrafficProgramListView"
                                              Grid.Row="0"
                                              Height="132"
                                              SelectionMode="Single"
                                              DisplayMemberPath="DisplayText"
                                              SelectionChanged="OnTrafficProgramSelectionChanged" />

                                    <StackPanel Grid.Row="1"
                                                Spacing="4">
                                        <Slider x:Name="TrafficPreviewTimeSlider"
                                                Minimum="0"
                                                Maximum="60"
                                                StepFrequency="0.25"
                                                ValueChanged="OnTrafficPreviewTimeChanged" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <Button x:Name="TrafficPlayButton"
                                                    Content="▶ Play"
                                                    Click="OnTrafficPlayClick" />
                                            <TextBlock x:Name="TrafficPhaseText"
                                                       VerticalAlignment="Center"
                                                       Text="Fase: —" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ListView x:Name="TrafficPhaseListView"
                                              Grid.Row="2"
                                              SelectionMode="None" />
                                </Grid>

                                <Grid x:Name="TrafficRulesPanel"
                                      Visibility="Collapsed"
                                      RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ComboBox x:Name="TrafficVehicleGroupComboBox"
                                              Grid.Row="0"
                                              Header="Grupo de veículo"
                                              DisplayMemberPath="Name"
                                              HorizontalAlignment="Stretch" />

                                    <ComboBox x:Name="TrafficRulePresetComboBox"
                                              Grid.Row="1"
                                              Header="Regra do editor OMSI"
                                              DisplayMemberPath="DisplayName"
                                              HorizontalAlignment="Stretch" />

                                    <ListView x:Name="TrafficRuleListView"
                                              Grid.Row="2"
                                              SelectionMode="Single"
                                              DisplayMemberPath="DisplayText"
                                              SelectionChanged="OnTrafficRuleSelectionChanged" />

                                    <Button x:Name="FocusTrafficRuleOwnerButton"
                                            Grid.Row="3"
                                            Content="Focar regra no mapa"
                                            IsEnabled="False"
                                            HorizontalAlignment="Stretch"
                                            Click="OnFocusTrafficRuleOwnerClick" />
                                </Grid>
                            </Grid>

                            <TextBlock x:Name="TrafficDetailText"
                                       Grid.Row="4"
                                       Text="Selecione um programa ou Traffic Rule."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#B7CEDC" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ExplorerSplitter"
                    Grid.Column="1"
                    Margin="1,8"
                    Background="#173347"
                    CornerRadius="3"
                    PointerPressed="OnPanelSplitterPointerPressed"
                    PointerMoved="OnPanelSplitterPointerMoved"
                    PointerReleased="OnPanelSplitterPointerReleased" />

            <controls:NativeViewport
                x:Name="Viewport"
                Grid.Column="2"
                Margin="0,8" />

            <Border x:Name="MapToolPalette"
                    Grid.Column="0"
                    Grid.ColumnSpan="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="20,20,20,28"
                    Padding="8"
                    Background="#E60A1B28"
                    BorderBrush="#355569"
                    BorderThickness="1"
                    CornerRadius="13"
                    Canvas.ZIndex="50">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <Button x:Name="ToolSelectionButton"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTipService.ToolTip="Seleção e edição"
                            Click="OnToolSelectionClick">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center">
                            <Path Width="23"
                                  Height="23"
                                  Stretch="Uniform"
                                  Stroke="#DDF4FF"
                                  StrokeThickness="1.8"
                                  Data="M 2,2 L 20,10 L 12,12 L 16,20 L 12,22 L 8,14 L 3,19 Z" />
                            <TextBlock Text="Seleção"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToolObjectsButton"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTipService.ToolTip="Objetos e cenário"
                            Click="OnToolObjectsClick">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center">
                            <Path Width="25"
                                  Height="23"
                                  Stretch="Uniform"
                                  Stroke="#DDF4FF"
                                  StrokeThickness="1.7"
                                  Data="M 12,2 L 21,7 L 21,17 L 12,22 L 3,17 L 3,7 Z M 3,7 L 12,12 L 21,7 M 12,12 L 12,22" />
                            <TextBlock Text="Objetos"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToolSplinesButton"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTipService.ToolTip="Ruas e splines"
                            Click="OnToolSplinesClick">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center">
                            <Path Width="25"
                                  Height="23"
                                  Stretch="Uniform"
                                  Stroke="#DDF4FF"
                                  StrokeThickness="1.8"
                                  Data="M 4,22 C 8,16 8,8 12,2 M 20,22 C 16,16 16,8 12,2 M 9,17 L 15,17 M 10.5,11 L 13.5,11" />
                            <TextBlock Text="Ruas"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToolCrossingsButton"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTipService.ToolTip="Cruzamentos"
                            Click="OnToolCrossingsClick">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center">
                            <Path Width="24"
                                  Height="23"
                                  Stretch="Uniform"
                                  Stroke="#DDF4FF"
                                  StrokeThickness="1.8"
                                  Data="M 9,2 L 15,2 L 15,9 L 22,9 L 22,15 L 15,15 L 15,22 L 9,22 L 9,15 L 2,15 L 2,9 L 9,9 Z M 12,4 L 12,20 M 4,12 L 20,12" />
                            <TextBlock Text="Cruzamentos"
                                       FontSize="10"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToolTerrainButton"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTipService.ToolTip="Terreno e pintura"
                            Click="OnToolTerrainClick">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center">
                            <Path Width="27"
                                  Height="23"
                                  Stretch="Uniform"
                                  Stroke="#DDF4FF"
                                  StrokeThickness="1.8"
                                  Data="M 2,20 L 8,10 L 12,15 L 16,6 L 23,20 Z M 5,20 L 20,20" />
                            <TextBlock Text="Terreno"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToolWaterButton"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTipService.ToolTip="Água"
                            Click="OnToolWaterClick">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center">
                            <Path Width="27"
                                  Height="23"
                                  Stretch="Uniform"
                                  Stroke="#DDF4FF"
                                  StrokeThickness="1.8"
                                  Data="M 2,8 C 5,5 8,11 11,8 C 14,5 17,11 22,8 M 2,14 C 5,11 8,17 11,14 C 14,11 17,17 22,14 M 2,20 C 5,17 8,23 11,20 C 14,17 17,23 22,20" />
                            <TextBlock Text="Água"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToolTrafficButton"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTipService.ToolTip="Tráfego e sinalização"
                            Click="OnToolTrafficClick">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center">
                            <Path Width="22"
                                  Height="23"
                                  Stretch="Uniform"
                                  Stroke="#DDF4FF"
                                  StrokeThickness="1.8"
                                  Data="M 7,2 L 17,2 L 17,22 L 7,22 Z M 12,6 A 2,2 0 1 0 12,6.1 M 12,12 A 2,2 0 1 0 12,12.1 M 12,18 A 2,2 0 1 0 12,18.1" />
                            <TextBlock Text="Tráfego"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToolTransportButton"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTipService.ToolTip="Transporte e operação"
                            Click="OnToolTransportClick">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center">
                            <Path Width="27"
                                  Height="23"
                                  Stretch="Uniform"
                                  Stroke="#DDF4FF"
                                  StrokeThickness="1.8"
                                  Data="M 4,4 Q 4,2 7,2 L 19,2 Q 22,2 22,5 L 22,18 L 4,18 Z M 7,6 L 19,6 L 19,12 L 7,12 Z M 8,18 L 8,22 M 18,18 L 18,22 M 7,22 L 9,22 M 17,22 L 19,22" />
                            <TextBlock Text="Transporte"
                                       FontSize="10"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToolValidationButton"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTipService.ToolTip="Validação do mapa"
                            Click="OnToolValidationClick">
                        <StackPanel Spacing="3"
                                    HorizontalAlignment="Center">
                            <Path Width="25"
                                  Height="23"
                                  Stretch="Uniform"
                                  Stroke="#DDF4FF"
                                  StrokeThickness="1.8"
                                  Data="M 12,2 A 10,10 0 1 1 11.9,2 M 7,12 L 10.5,16 L 18,8" />
                            <TextBlock Text="Validar"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="InspectorSplitter"
                    Grid.Column="3"
                    Margin="1,8"
                    Background="#173347"
                    CornerRadius="3"
                    PointerPressed="OnPanelSplitterPointerPressed"
                    PointerMoved="OnPanelSplitterPointerMoved"
                    PointerReleased="OnPanelSplitterPointerReleased" />

            <Border x:Name="InspectorPanel"
                    Grid.Column="4"
                    Margin="8"
                    Background="#0C2130"
                    CornerRadius="8">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="14" Spacing="10">
                        <TextBlock Text="Inspector"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectionText"
                                   Text="Sem seleção"
                                   FontSize="14"
                                   Foreground="#9FB5C5" />
                        <TextBlock x:Name="InspectorTypeText"
                                   Text="Tipo: —"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="InspectorAssetText"
                                   Text="Arquivo: —"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="#B9CAD6" />
                        <TextBlock x:Name="InspectorTileText"
                                   Text="Tile: —"
                                   FontSize="13"
                                   Foreground="#B9CAD6" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <NumberBox x:Name="InspectorXBox"
                                       Grid.Column="0"
                                       Header="X"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25" />
                            <NumberBox x:Name="InspectorYBox"
                                       Grid.Column="1"
                                       Header="Y"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25" />
                            <NumberBox x:Name="InspectorZBox"
                                       Grid.Column="2"
                                       Header="Z"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25" />
                        </Grid>

                        <NumberBox x:Name="InspectorRotationBox"
                                   Header="Rotação"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="5" />

                        <StackPanel x:Name="InspectorObjectFields"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <NumberBox x:Name="InspectorPitchBox"
                                       Header="Pitch"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="5" />
                            <NumberBox x:Name="InspectorBankBox"
                                       Header="Bank"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="5" />
                        </StackPanel>

                        <StackPanel x:Name="InspectorSplineFields"
                                    Spacing="8"
                                    Visibility="Collapsed">
                            <NumberBox x:Name="InspectorLengthBox"
                                       Header="Comprimento"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25"
                                       Minimum="0" />
                            <NumberBox x:Name="InspectorRadiusBox"
                                       Header="Raio"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.25" />
                            <NumberBox x:Name="InspectorGradientStartBox"
                                       Header="Gradiente inicial (%)"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.1" />
                            <NumberBox x:Name="InspectorGradientEndBox"
                                       Header="Gradiente final (%)"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="0.1" />

                            <TextBlock Text="Vínculos da cadeia"
                                       Margin="0,6,0,0"
                                       FontWeight="SemiBold" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <NumberBox x:Name="InspectorPreviousSplineIdBox"
                                           Grid.Column="0"
                                           Header="Anterior ID"
                                           SpinButtonPlacementMode="Compact"
                                           SmallChange="1" />

                                <NumberBox x:Name="InspectorNextSplineIdBox"
                                           Grid.Column="1"
                                           Header="Próxima ID"
                                           SpinButtonPlacementMode="Compact"
                                           SmallChange="1" />
                            </Grid>

                            <Button x:Name="SaveSplineLinksButton"
                                    Content="Salvar vínculos"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="False"
                                    Click="OnSaveSplineLinksClick" />
                        </StackPanel>

                        <Button x:Name="ApplyInspectorButton"
                                Content="Aplicar valores"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="OnApplyInspectorClick" />

                        <Button x:Name="DuplicateSelectionButton"
                                Content="Colocar cópia"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="OnDuplicateSelectionClick" />

                        <Button x:Name="DeleteSelectionButton"
                                Content="Excluir selecionado"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="OnDeleteSelectionClick" />

                        <Border Height="1"
                                Margin="0,8,0,4"
                                Background="#173347" />

                        <TextBlock Text="Terreno"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <Button x:Name="PickTerrainPointButton"
                                Content="Escolher ponto no mapa"
                                HorizontalAlignment="Stretch"
                                Click="OnPickTerrainPointClick" />

                        <TextBlock x:Name="TerrainPointText"
                                   Text="Nenhum ponto selecionado."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#9FB5C5" />

                        <NumberBox x:Name="TerrainTargetHeightBox"
                                   Header="Altura alvo (m)"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="0.25" />

                        <NumberBox x:Name="TerrainBrushRadiusBox"
                                   Header="Raio do pincel (m)"
                                   Value="20"
                                   Minimum="0.25"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="1" />

                        <NumberBox x:Name="TerrainBrushFeatherBox"
                                   Header="Feather (0–1)"
                                   Value="0.25"
                                   Minimum="0"
                                   Maximum="1"
                                   SpinButtonPlacementMode="Compact"
                                   SmallChange="0.05" />

                        <Button x:Name="ApplyTerrainLevelButton"
                                Content="Aplicar nivelamento"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="OnApplyTerrainLevelClick" />

                        <TextBlock Text="Pintura de textura"
                                   Margin="0,8,0,0"
                                   FontWeight="SemiBold" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <NumberBox x:Name="TerrainPaintLayerBox"
                                       Grid.Column="0"
                                       Header="Camada groundtex"
                                       Value="1"
                                       Minimum="1"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="1" />

                            <NumberBox x:Name="TerrainPaintAlphaBox"
                                       Grid.Column="1"
                                       Header="Alpha 0–255"
                                       Value="255"
                                       Minimum="0"
                                       Maximum="255"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="16" />
                        </Grid>

                        <Button x:Name="ApplyTerrainPaintButton"
                                Content="Pintar textura no ponto"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="OnApplyTerrainPaintClick" />

                        <TextBlock Text="Seleção e edição usam o mesmo estado nativo do viewport e do ID Buffer."
                                   TextWrapping="Wrap"
                                   Foreground="#7FA6BF" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Background="#061018"
              Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Text="Runtime nativo pronto para inicialização" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Text="WinUI 3 · Direct3D 11 · .NET 10"
                       Foreground="#7FA6BF" />
        </Grid>
    </Grid>
</Window>
