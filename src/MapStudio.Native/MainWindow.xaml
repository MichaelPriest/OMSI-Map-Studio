                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Novo"
                                        ToolTipService.ToolTip="Criar um novo mapa no Workspace"
                                        Click="OnCreateStandaloneMapClick" />
                                <Button Grid.Column="1"
                                        Content="Abrir"
                                        ToolTipService.ToolTip="Abrir um mapa do catálogo"
                                        IsEnabled="{x:Bind OpenMapButton.IsEnabled, Mode=OneWay}"
                                        Click="OnOpenMapCatalogClick" />
                                <Button Grid.Column="2"
                                        Content="Importar"
                                        ToolTipService.ToolTip="Importar mapa existente para o Workspace"
                                        Click="OnImportStandaloneMapClick" />
                                <Button Grid.Column="3"
                                        Content="+ Assets"
                                        ToolTipService.ToolTip="Adicionar pasta de itens ao Workspace"
                                        Click="OnAddAssetFolderClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="4">
                        <ListView x:Name="ExplorerListView"
                                  SelectionMode="Single"
                                  SelectionChanged="OnExplorerSelectionChanged"
                                  DoubleTapped="OnExplorerDoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2"
                                            Padding="8"
                                            Background="#0A1B27"
                                            BorderBrush="#24485C"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    MinWidth="48"
                                                    Padding="6,4"
                                                    VerticalAlignment="Top"
                                                    Background="#12384C"
                                                    CornerRadius="5">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#A7E8FF" />
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="2">
                                                <TextBlock Text="{Binding AssetName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="#EAF7FC" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           FontSize="10"
                                                           Foreground="#9FB5C5" />
                                                <TextBlock Text="{Binding AssetPath}"
                                                           FontSize="9.5"
                                                           Foreground="#66899D"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid x:Name="AssetLibraryPanel"
                              Visibility="Collapsed"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#0A1B27"
                                    BorderBrush="#24485C"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                <StackPanel Spacing="7">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="BIBLIOTECA DE ASSETS"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       CharacterSpacing="40"
                                                       Foreground="#DDF4FF" />
                                            <TextBlock Text="Filtre, visualize e posicione itens no mapa"
                                                       FontSize="10"
                                                       Foreground="#7895AD" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Content="↻"
                                                ToolTipService.ToolTip="Reindexar biblioteca"
                                                Click="OnRefreshLibraryClick" />
                                    </Grid>

                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="LibraryKindComboBox"
                                                  Grid.Column="0"
                                                  Header="Tipo"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnLibraryKindSelectionChanged">
                                            <ComboBoxItem Content="Todos" />
                                            <ComboBoxItem Content="Objetos SCO" />
                                            <ComboBoxItem Content="Splines SLI" />
                                            <ComboBoxItem Content="Modelos" />
                                            <ComboBoxItem Content="Texturas" />
                                        </ComboBox>

                                        <ComboBox x:Name="LibraryViewComboBox"
                                                  Grid.Column="1"
                                                  Header="Visão"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnLibraryViewSelectionChanged">
                                            <ComboBoxItem Content="Grupos" />
                                            <ComboBoxItem Content="Favoritos" />
                                            <ComboBoxItem Content="Recentes" />
                                            <ComboBoxItem Content="Frequentes" />
                                            <ComboBoxItem Content="Coleção" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="LibraryGroupComboBox"
                                                  Grid.Column="0"
                                                  Header="Categoria"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  DisplayMemberPath="Label"
                                                  SelectionChanged="OnLibraryGroupSelectionChanged" />

                                        <ComboBox x:Name="LibrarySubcategoryComboBox"
                                                  Grid.Column="1"
                                                  Header="Subcategoria"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnLibrarySubcategorySelectionChanged" />
                                    </Grid>

                                    <ComboBox x:Name="LibraryTechnicalFilterComboBox"
                                              Header="Filtro técnico"
                                              SelectedIndex="0"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnLibraryTechnicalFilterSelectionChanged" />

                                    <StackPanel x:Name="LibraryCollectionPanel"
                                                Visibility="Collapsed"
                                                Spacing="5">
                                        <ComboBox x:Name="LibraryCollectionComboBox"
                                                  Header="Coleção ativa"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnLibraryCollectionSelectionChanged" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="+ Nova coleção"
                                                    Click="OnCreateLibraryCollectionClick" />
                                            <Button Grid.Column="1"
                                                    Content="Excluir"
                                                    Click="OnDeleteLibraryCollectionClick" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="1"
                                        Spacing="6">
                                <Border Background="#102A39"
                                        BorderBrush="#315064"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7">
                                    <StackPanel Spacing="6">
                                        <Button x:Name="PlaceAssetButton"
                                                Content="＋ Posicionar no mapa"
                                                IsEnabled="False"
                                                MinHeight="36"
                                                Background="#185B78"
                                                BorderBrush="#75D9FF"
                                                HorizontalAlignment="Stretch"
                                                Click="OnPlaceAssetClick" />

                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="FavoriteAssetButton"
                                                    Grid.Column="0"
                                                    Content="☆ Favoritar"
                                                    IsEnabled="False"
                                                    Click="OnFavoriteAssetClick" />
                                            <Button x:Name="CollectionAssetButton"
                                                    Grid.Column="1"
                                                    Content="+ Coleção"
                                                    IsEnabled="False"
                                                    Click="OnCollectionAssetClick" />
                                        </Grid>

                                        <Button x:Name="RepairDependencyButton"
                                                Content="Usar como substituição"
                                                Visibility="Collapsed"
                                                IsEnabled="False"
                                                HorizontalAlignment="Stretch"
                                                Click="OnRepairDependencyClick" />
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="ObjectPlacementOptionsPanel"
                                            Visibility="Collapsed"
