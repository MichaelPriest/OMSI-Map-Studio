                                                   Value="12"
                                                   SmallChange="0.5" />
                                        <NumberBox x:Name="PlacementRadiusBox"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Header="Raio (m)"
                                                   Minimum="0.5"
                                                   Maximum="150"
                                                   Value="20"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementCountBox"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   Header="Quantidade"
                                                   Minimum="1"
                                                   Maximum="256"
                                                   Value="18"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementSetbackBox"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Header="Recuo (m)"
                                                   Minimum="-100"
                                                   Maximum="100"
                                                   Value="7"
                                                   SmallChange="0.5" />
                                        <NumberBox x:Name="PlacementRowsBox"
                                                   Grid.Row="2"
                                                   Grid.Column="0"
                                                   Header="Linhas"
                                                   Minimum="1"
                                                   Maximum="16"
                                                   Value="4"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementColumnsBox"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Header="Colunas"
                                                   Minimum="1"
                                                   Maximum="16"
                                                   Value="4"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementSpacingXBox"
                                                   Grid.Row="3"
                                                   Grid.Column="0"
                                                   Header="Espaço X"
                                                   Minimum="0.5"
                                                   Maximum="100"
                                                   Value="6"
                                                   SmallChange="0.5" />
                                        <NumberBox x:Name="PlacementSpacingZBox"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Header="Espaço Y"
                                                   Minimum="0.5"
                                                   Maximum="100"
                                                   Value="6"
                                                   SmallChange="0.5" />
                                    </Grid>

                                    <CheckBox x:Name="PlacementRandomRotationCheckBox"
                                              Content="Rotação variada" />

                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="PlacementAlignRoadCheckBox"
                                                  Grid.Column="0"
                                                  Content="Encaixar / alinhar à rua"
                                                  ToolTipService.ToolTip="Move o ghost para o eixo da spline mais próxima e alinha a rotação à tangente da via." />
                                        <NumberBox x:Name="PlacementRoadSnapDistanceBox"
                                                   Grid.Column="1"
                                                   Header="Alcance rua (m)"
                                                   Minimum="1"
                                                   Maximum="50"
                                                   Value="8"
                                                   SmallChange="1"
                                                   SpinButtonPlacementMode="Compact" />
                                    </Grid>

                                    <CheckBox x:Name="PlacementTangentCheckBox"
                                              Content="Círculo tangencial"
                                              IsChecked="True" />

                                    <TextBlock Text="Linha/Lotes: clique o início e depois o fim. Área, matriz e círculo usam o clique como centro."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#7895AD" />
                                </StackPanel>

                                <StackPanel x:Name="SplinePlacementOptionsPanel"
                                            Visibility="Collapsed"
                                            Spacing="5">
                                    <CheckBox x:Name="SplineEasyRoadCheckBox"
                                              Content="Estrada fácil (2 cliques)"
                                              Click="OnSplineEasyRoadToggle" />
                                    <CheckBox x:Name="SplineHeightCheckBox"
                                              Content="Criar como [spline_h] (altura)"
                                              Click="OnSplineHeightToggle" />
                                    <NumberBox x:Name="SplineCurveOffsetBox"
                                               Header="Curva lateral / offset (m)"
                                               Minimum="-500"
                                               Maximum="500"
                                               Value="0"
                                               SmallChange="0.5"
                                               SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnSplineCurveOffsetChanged" />
