<Window
    x:Class="MapStudio.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MapStudio.Native.Controls"
    Title="OMSI Map Studio — World Creator">

    <Grid x:Name="MainRoot"
          RequestedTheme="Default"
          Background="{ThemeResource MapStudioWindowBackgroundBrush}">
        <Grid.Resources>
            <ResourceDictionary>
            <SolidColorBrush x:Key="MapToolDefaultBackgroundBrush"
                             Color="{ThemeResource MapStudioSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="MapToolDefaultBorderBrush"
                             Color="{ThemeResource MapStudioBorderStrongColor}" />
            <SolidColorBrush x:Key="MapToolActiveBackgroundBrush"
                             Color="{ThemeResource MapStudioAccentSurfaceColor}" />
            <SolidColorBrush x:Key="MapToolActiveBorderBrush"
                             Color="{ThemeResource MapStudioAccentColor}" />
            <SolidColorBrush x:Key="ExplorerModeDefaultBackgroundBrush"
                             Color="{ThemeResource MapStudioSurfaceRaisedColor}" />
            <SolidColorBrush x:Key="ExplorerModeDefaultBorderBrush"
                             Color="{ThemeResource MapStudioBorderColor}" />
            <SolidColorBrush x:Key="ExplorerModeActiveBackgroundBrush"
                             Color="{ThemeResource MapStudioAccentSurfaceColor}" />
            <SolidColorBrush x:Key="ExplorerModeActiveBorderBrush"
                             Color="{ThemeResource MapStudioAccentColor}" />
            <Style x:Key="MapToolButtonStyle"
                   TargetType="Button">
                <Setter Property="Width"
                        Value="64" />
                <Setter Property="Height"
                        Value="54" />
                <Setter Property="Padding"
                        Value="5" />
                <Setter Property="Background"
                        Value="{StaticResource MapToolDefaultBackgroundBrush}" />
                <Setter Property="BorderBrush"
                        Value="{StaticResource MapToolDefaultBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="9" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
            </Style>
            <Style x:Key="EditorToolbarButtonStyle"
                   TargetType="Button">
                <Setter Property="MinHeight"
                        Value="27" />
                <Setter Property="Padding"
                        Value="8,3" />
                <Setter Property="FontSize"
                        Value="10.5" />
                <Setter Property="Background"
                        Value="{ThemeResource MapStudioSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush"
                        Value="{ThemeResource MapStudioBorderStrongBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="6" />
            </Style>
            <Style x:Key="ExplorerModeButtonStyle"
                   TargetType="Button">
                <Setter Property="MinHeight"
                        Value="36" />
                <Setter Property="Padding"
                        Value="6,5" />
                <Setter Property="FontSize"
                        Value="10.5" />
                <Setter Property="Background"
                        Value="{StaticResource ExplorerModeDefaultBackgroundBrush}" />
                <Setter Property="BorderBrush"
                        Value="{StaticResource ExplorerModeDefaultBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="7" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
            </Style>
            <Style x:Key="EditorModuleRailButtonStyle"
                   TargetType="Button">
                <Setter Property="Width"
                        Value="44" />
                <Setter Property="Height"
                        Value="44" />
                <Setter Property="Padding"
                        Value="7" />
                <Setter Property="Background"
                        Value="{StaticResource MapToolDefaultBackgroundBrush}" />
                <Setter Property="BorderBrush"
                        Value="{StaticResource MapToolDefaultBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="6" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
            </Style>
            <Style x:Key="MapToolGroupBadgeStyle"
                   TargetType="Border">
                <Setter Property="Width"
                        Value="42" />
                <Setter Property="Height"
                        Value="54" />
                <Setter Property="Margin"
                        Value="3,0" />
                <Setter Property="Padding"
                        Value="5" />
                <Setter Property="Background"
                        Value="{ThemeResource MapStudioSurfaceAltBrush}" />
                <Setter Property="BorderBrush"
                        Value="{ThemeResource MapStudioBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="8" />
            </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11"
                                 Invoked="OnFullscreenAcceleratorInvoked" />
            <KeyboardAccelerator Key="W"
                                 Invoked="OnMoveAcceleratorInvoked" />
            <KeyboardAccelerator Key="E"
                                 Invoked="OnRotateAcceleratorInvoked" />
            <KeyboardAccelerator Key="S"
                                 Modifiers="Control"
                                 Invoked="OnSaveAcceleratorInvoked" />
            <KeyboardAccelerator Key="Z"
                                 Modifiers="Control"
                                 Invoked="OnUndoAcceleratorInvoked" />
            <KeyboardAccelerator Key="Y"
                                 Modifiers="Control"
                                 Invoked="OnRedoAcceleratorInvoked" />
            <KeyboardAccelerator Key="Escape"
                                 Invoked="OnEscapeAcceleratorInvoked" />
            <KeyboardAccelerator Key="Delete"
                                 Invoked="OnDeleteAcceleratorInvoked" />
            <KeyboardAccelerator Key="D"
                                 Modifiers="Control"
                                 Invoked="OnDuplicateAcceleratorInvoked" />
            <KeyboardAccelerator Key="F"
                                 Invoked="OnFocusSelectionAcceleratorInvoked" />
            <KeyboardAccelerator Key="N"
                                 Invoked="OnSnapAcceleratorInvoked" />
            <KeyboardAccelerator Key="T"
                                 Invoked="OnTerrainVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="G"
                                 Invoked="OnGridVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="O"
                                 Invoked="OnObjectsVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="L"
                                 Invoked="OnSplinesVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="P"
                                 Invoked="OnSplineProfilesVisibilityAcceleratorInvoked" />
            <KeyboardAccelerator Key="Q"
                                 Invoked="OnSelectAllAcceleratorInvoked" />
            <KeyboardAccelerator Key="Home"
                                 Invoked="OnFitSceneAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number1"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionAllAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number2"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionObjectsAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number3"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionSplinesAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number4"
                                 Modifiers="Menu"
                                 Invoked="OnSelectionTerrainAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number1"
                                 Invoked="OnPerspectiveAcceleratorInvoked" />
            <KeyboardAccelerator Key="Number2"
                                 Invoked="OnTopAcceleratorInvoked" />
            <KeyboardAccelerator Key="R"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="C"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="O"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="B"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="G"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="Y"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="T"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
            <KeyboardAccelerator Key="A"
                                 Modifiers="Shift"
                                 Invoked="OnQuickCreateAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Grid x:Name="DesktopChromePanel"
              Grid.Row="0"
              Background="{ThemeResource MapStudioChromeBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Margin="8,4,10,4"
                    Padding="12,5"
                    Background="{ThemeResource MapStudioSurfaceAltBrush}"
                    BorderBrush="{ThemeResource MapStudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal"
                            Spacing="9">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="7"
                            Background="{ThemeResource MapStudioSurfaceRaisedBrush}">
                        <TextBlock Text="M"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource MapStudioAccentTextBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center"
                                Spacing="-2">
                        <TextBlock Text="MAP STUDIO"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource MapStudioTextPrimaryBrush}" />
                        <TextBlock Text="WORLD CREATOR"
                                   FontSize="9"
                                   CharacterSpacing="110"
                                   Foreground="{ThemeResource MapStudioAccentTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <MenuBar Grid.Row="0"
                     Grid.Column="1">
                <MenuBarItem Title="Arquivo">
                    <MenuFlyoutItem
                        Text="Workspace Map Studio"
                        Click="OnOpenWorkspaceClick" />
                    <MenuFlyoutItem
                        Text="Novo mapa..."
                        Click="OnCreateStandaloneMapClick" />
                    <MenuFlyoutItem
                        Text="Importar mapa existente..."
                        Click="OnImportStandaloneMapClick" />
                    <MenuFlyoutItem
                        Text="Adicionar pasta de itens..."
                        Click="OnAddAssetFolderClick" />
                    <MenuFlyoutItem
                        Text="Exportar mapa como pacote OMSI..."
                        Click="OnExportWorkspaceOmsiPackageClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Abrir OMSI..."
                        Click="OnOpenOmsiClick" />
                    <MenuFlyoutItem
                        x:Name="OpenMapMenuItem"
                        Text="Abrir mapa do catálogo..."
                        IsEnabled="False"
                        Click="OnOpenMapCatalogClick" />
                    <MenuFlyoutItem
                        x:Name="RefreshMapCatalogMenuItem"
                        Text="Atualizar catálogo de mapas"
                        IsEnabled="False"
                        Click="OnRefreshMapCatalogClick" />
                    <MenuFlyoutItem
                        Text="Abrir pasta de mapa..."
                        Click="OnOpenMapClick" />
                </MenuBarItem>
                <MenuBarItem Title="Editar">
                    <MenuFlyoutItem
                        x:Name="UndoConstructionMenuItem"
                        Text="Desfazer construção"
                        IsEnabled="False"
                        Click="OnUndoConstructionClick" />
                    <MenuFlyoutItem
                        x:Name="RedoConstructionMenuItem"
                        Text="Refazer construção"
                        IsEnabled="False"
                        Click="OnRedoConstructionClick" />
                </MenuBarItem>
                <MenuBarItem Title="Visualizar">
                    <MenuFlyoutItem
                        Text="Tela cheia (F11)"
                        Click="OnFullscreenClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Perspectiva"
                        Click="OnPerspectiveViewClick" />
                    <MenuFlyoutItem
                        Text="Vista superior"
                        Click="OnTopViewClick" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowTerrainMenuItem"
                        Text="Terreno"
                        IsChecked="True"
                        Click="OnSceneVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowTerrainPaintMenuItem"
                        Text="Pintura do terreno"
                        IsChecked="True"
                        IsEnabled="False"
                        Click="OnTerrainPaintVisibilityClick" />
                    <MenuFlyoutSubItem
                        x:Name="TerrainLayersMenuItem"
                        Text="Camadas pintadas"
                        IsEnabled="False">
                        <MenuFlyoutItem
                            Text="Abra um mapa..."
                            IsEnabled="False" />
                    </MenuFlyoutSubItem>
                    <ToggleMenuFlyoutItem
                        x:Name="ShowObjectsMenuItem"
                        Text="Objetos"
                        IsChecked="True"
                        Click="OnSceneVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowSplinesMenuItem"
                        Text="Splines"
                        IsChecked="True"
                        Click="OnSceneVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowGridMenuItem"
                        Text="Grade"
                        IsChecked="True"
                        Click="OnGridVisibilityClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="ShowSplineProfilesMenuItem"
                        Text="Perfis reais das splines"
                        IsChecked="True"
                        Click="OnSplineProfilesVisibilityClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Alternar Explorer"
                        Click="OnToggleExplorerClick" />
                    <MenuFlyoutItem
                        Text="Alternar Inspector"
                        Click="OnToggleInspectorClick" />
                </MenuBarItem>
                <MenuBarItem Title="Mapa">
                    <MenuFlyoutItem
                        x:Name="FullMapModeMenuItem"
                        Text="Mapa completo"
                        Click="OnFullMapModeClick" />
                    <MenuFlyoutItem
                        x:Name="PerformanceMapModeMenuItem"
                        Text="Modo desempenho 3×3"
                        Click="OnPerformanceMapModeClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Abrir painel Mapa / Tiles"
                        Click="OnMapExplorerModeClick" />
                    <MenuFlyoutItem
                        Text="Criar tile..."
                        Click="OnCreateMapTileClick" />
                    <MenuFlyoutItem
                        Text="Excluir tile ativo..."
                        Click="OnDeleteActiveMapTileClick" />
                    <MenuFlyoutItem
                        Text="Criar mapa real por área..."
                        Click="OnCreateCoordinateMapClick" />
                    <MenuFlyoutItem
                        Text="Mapa real avançado por coordenadas..."
                        Click="OnCreateCoordinateMapAdvancedClick" />
                    <MenuFlyoutItem
                        Text="Georreferência do mapa..."
                        Click="OnEditMapGeoreferenceClick" />
                    <MenuFlyoutItem
                        Text="Aplicar elevação Google no tile ativo..."
                        Click="OnGoogleElevationClick" />
                    <MenuFlyoutItem
                        Text="Importar grade local de elevação no tile ativo..."
                        Click="OnImportLocalElevationGridClick" />
                    <MenuFlyoutItem
                        Text="Referência de mapa sobre o terreno..."
                        Click="OnMapReferenceClick" />
                    <ToggleMenuFlyoutItem
                        x:Name="MapReferenceVisibilityMenuItem"
                        Text="Mostrar referência de mapa"
                        IsChecked="False"
                        Click="OnToggleMapReferenceVisibilityClick" />
                    <MenuFlyoutItem
                        Text="Remover referência de mapa"
                        Click="OnClearGoogleMapReferenceClick" />
                </MenuBarItem>
                <MenuBarItem Title="Ferramentas">
                    <MenuFlyoutItem
                        Text="Substituir dependência SCO/SLI..."
                        Click="OnReplaceDependencyClick" />
                    <MenuFlyoutItem
                        Text="Restaurar backup do Map Studio..."
                        Click="OnRestoreBackupClick" />
                    <MenuFlyoutItem
                        Text="Inspecionar attachments..."
                        Click="OnInspectAttachmentsClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Construction Sets..."
                        Click="OnConstructionSetsClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Building Studio..."
                        Click="OnBuildingStudioClick" />
                    <MenuFlyoutItem
                        Text="Importar edifícios OSM..."
                        Click="OnImportOsmBuildingsClick" />
                    <MenuFlyoutItem
                        Text="Importar vegetação OSM..."
                        Click="OnImportOsmVegetationClick" />
                    <MenuFlyoutItem
                        Text="Instalar/atualizar Road Kit..."
                        Click="OnInstallRoadKitClick" />
                    <MenuFlyoutItem
                        Text="Criador de pontes..."
                        Click="OnCreateBridgeClick" />
                    <MenuFlyoutItem
                        Text="Criador de túneis..."
                        Click="OnCreateTunnelClick" />
                    <MenuFlyoutSubItem
                        Text="Gerador procedural de vias">
                        <MenuFlyoutItem
                            Text="Analisar referência de mapa com IA..."
                            Click="OnAnalyzeGoogleRoadReferenceWithAiClick" />
                        <MenuFlyoutItem
                            Text="Importar GeoJSON georreferenciado..."
                            Click="OnImportProceduralRoadGeoJsonClick" />
                        <MenuFlyoutItem
                            Text="Importar OSM XML georreferenciado..."
                            Click="OnImportProceduralRoadOsmClick" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Text="Iniciar nova linha..."
                            Click="OnStartProceduralRoadTraceClick" />
                        <MenuFlyoutItem
                            x:Name="FinishProceduralRoadTraceMenuItem"
                            Text="Finalizar linha atual"
                            IsEnabled="False"
                            Click="OnFinishProceduralRoadTraceClick" />
                        <MenuFlyoutItem
                            x:Name="AnalyzeProceduralRoadGraphMenuItem"
                            Text="Analisar grafo/interseções..."
                            IsEnabled="False"
                            Click="OnAnalyzeProceduralRoadGraphClick" />
                        <MenuFlyoutItem
                            x:Name="ClearProceduralRoadGraphMenuItem"
                            Text="Limpar traçado"
                            IsEnabled="False"
                            Click="OnClearProceduralRoadGraphClick" />
                    </MenuFlyoutSubItem>
                </MenuBarItem>
                <MenuBarItem Title="IA">
                    <MenuFlyoutItem
                        x:Name="AiConnectMenuItem"
                        Text="Conectar / testar IA no mapa..."
                        Click="OnConnectAiToMapClick" />
                    <MenuFlyoutItem
                        x:Name="AiActiveProfileMenuItem"
                        Text="Nenhum perfil ativo"
                        IsEnabled="False" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Text="Abrir painel IA..."
                        Click="OnToggleAiToolWindowClick" />
                    <MenuFlyoutItem
                        Text="Configurar provedores..."
                        Click="OnAiProvidersClick" />
                </MenuBarItem>
                <MenuBarItem Title="Conta">
                    <MenuFlyoutItem
                        Text="Assinatura e licença..."
                        Click="OnCommercialStatusClick" />
                </MenuBarItem>
                <MenuBarItem Title="Ajuda">
                    <MenuFlyoutItem
                        Text="Manual do Usuário (Português)"
                        Click="OnOpenUserManualPtBrClick" />
                    <MenuFlyoutItem
                        Text="User Manual (English)"
                        Click="OnOpenUserManualEnClick" />
                </MenuBarItem>
            </MenuBar>

            <ScrollViewer
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalScrollMode="Auto"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled">
                <Border Margin="8,2,8,6"
                        Padding="8,6"
                        Background="{ThemeResource MapStudioSurfaceAltBrush}"
                        BorderBrush="{ThemeResource MapStudioBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    HorizontalAlignment="Left">
                            <Button x:Name="SaveChangesButton"
                                    Style="{StaticResource EditorToolbarButtonStyle}"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Salvar alterações (Ctrl+S)"
                                    Click="OnSaveChangesClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="Salvar" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="UndoButton"
                                    Style="{StaticResource EditorToolbarButtonStyle}"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Desfazer (Ctrl+Z)"
                                    Click="OnUndoClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <SymbolIcon Symbol="Undo" />
                                    <TextBlock Text="Desfazer" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RedoButton"
                                    Style="{StaticResource EditorToolbarButtonStyle}"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Refazer (Ctrl+Y)"
                                    Click="OnRedoClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <SymbolIcon Symbol="Redo" />
                                    <TextBlock Text="Refazer" />
                                </StackPanel>
                            </Button>
                            <Rectangle Width="1"
                                       Height="24"
                                       Fill="{ThemeResource MapStudioBorderBrush}"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Modo Criador em tela cheia"
                                    Click="OnFullscreenClick">
                                <SymbolIcon Symbol="FullScreen" />
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="10,4"
                                Background="{ThemeResource MapStudioSurfaceRaisedBrush}"
                                BorderBrush="{ThemeResource MapStudioBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{ThemeResource MapStudioSuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="RootModeText"
                                           Text="WORKSPACE"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource MapStudioAccentTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Map Studio"
                                           FontSize="11"
                                           Foreground="{ThemeResource MapStudioTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="7"
                                    HorizontalAlignment="Right">
                            <CheckBox x:Name="NightPreviewCheckBox"
                                      Content="Dia/noite"
                                      VerticalAlignment="Center"
                                      Checked="OnNightPreviewChecked"
                                      Unchecked="OnNightPreviewUnchecked" />
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="Workspace"
                                    ToolTipService.ToolTip="Voltar ao Workspace Map Studio"
                                    Click="OnOpenWorkspaceClick" />
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="Abrir OMSI"
                                    ToolTipService.ToolTip="Usar opcionalmente mapas e itens da instalação do OMSI"
                                    Click="OnOpenOmsiClick" />
                            <ComboBox x:Name="AiProfileSelectorBox"
                                      Width="170"
                                      PlaceholderText="Perfil de IA"
                                      ToolTipService.ToolTip="Seleciona imediatamente o perfil de IA ativo para as ferramentas do mapa"
                                      SelectionChanged="OnAiProfileSelectorChanged" />
                            <Button x:Name="AiStatusButton"
                                    Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="IA: conectar"
                                    ToolTipService.ToolTip="Conectar ou testar o provedor de IA usado pelas ferramentas do mapa"
                                    Click="OnConnectAiToMapClick" />
                            <Border Padding="4,2"
                                    Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                    BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    ToolTipService.ToolTip="Navegação rápida entre tiles">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="2">
                                    <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                            MinWidth="30"
                                            Padding="6,3"
                                            Content="←"
                                            Tag="-1,0"
                                            ToolTipService.ToolTip="Tile à esquerda"
                                            Click="OnTileNavigateClick" />
                                    <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                            MinWidth="30"
                                            Padding="6,3"
                                            Content="↑"
                                            Tag="0,-1"
                                            ToolTipService.ToolTip="Tile acima"
                                            Click="OnTileNavigateClick" />
                                    <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                            MinWidth="30"
                                            Padding="6,3"
                                            Content="↓"
                                            Tag="0,1"
                                            ToolTipService.ToolTip="Tile abaixo"
                                            Click="OnTileNavigateClick" />
                                    <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                            MinWidth="30"
                                            Padding="6,3"
                                            Content="→"
                                            Tag="1,0"
                                            ToolTipService.ToolTip="Tile à direita"
                                            Click="OnTileNavigateClick" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Abrir navegador Tile X/Y em janela flutuante"
                                    Click="OnToggleTileNavigatorWindowClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="⌖" FontSize="13" />
                                    <TextBlock Text="Tile XY" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Abrir painel de IA"
                                    Click="OnToggleAiToolWindowClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="✦" FontSize="13" />
                                    <TextBlock Text="IA painel" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Abrir Biblioteca em janela flutuante"
                                    Click="OnToggleAssetLibraryWindowClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="▦" FontSize="13" />
                                    <TextBlock Text="Biblioteca" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Abrir Route Studio / Transporte em janela flutuante"
                                    Click="OnToggleTransportWindowClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="↔" FontSize="13" />
                                    <TextBlock Text="Transporte" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource EditorToolbarButtonStyle}"
                                    ToolTipService.ToolTip="Abrir controles de Paths OMSI em janela flutuante"
                                    Click="OnToggleTrafficPathsWindowClick">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="↝" FontSize="13" />
                                    <TextBlock Text="Paths" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenMapButton"
                                    Style="{StaticResource EditorToolbarButtonStyle}"
                                    Content="Mapas"
                                    IsEnabled="False"
                                    Click="OnOpenMapCatalogClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="WorkspaceGrid"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn"
                                  Width="300" />
                <ColumnDefinition x:Name="ExplorerSplitterColumn"
                                  Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitterColumn"
                                  Width="6" />
                <ColumnDefinition x:Name="InspectorColumn"
                                  Width="290" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ExplorerPanel"
                    Grid.Column="0"
                    Margin="6"
                    Background="{ThemeResource MapStudioPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource MapStudioBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FullscreenExplorerTranslate" />
                </Border.RenderTransform>
                <Grid Padding="9" RowSpacing="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          ColumnSpacing="8"
                          Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="1">
                            <TextBlock x:Name="ExplorerPanelTitleText"
                                       Text="PROJETO"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="55" />
                            <TextBlock x:Name="ExplorerModeSubtitleText"
                                       Text="Cena e conteúdo do mapa"
                                       FontSize="11"
                                       Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="5">
                            <Button x:Name="RefreshLibraryButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Content="↻"
                                    ToolTipService.ToolTip="Atualizar biblioteca"
                                    IsEnabled="False"
                                    Click="OnRefreshLibraryClick" />
                            <Button x:Name="MinimizeExplorerPanelButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Content="—"
                                    ToolTipService.ToolTip="Minimizar painel Projeto"
                                    Click="OnMinimizeExplorerPanelClick" />
                            <Border Width="28"
                                    Height="28"
                                    Background="{ThemeResource MapStudioSurfaceRaisedBrush}"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="Arraste para mover o painel"
                                    PointerPressed="OnExplorerFloatingDragPressed"
                                    PointerMoved="OnExplorerFloatingDragMoved"
                                    PointerReleased="OnExplorerFloatingDragReleased"
                                    PointerCanceled="OnExplorerFloatingDragReleased">
                                <TextBlock Text="⋮⋮"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource MapStudioAccentTextBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ExplorerModeGrid"
                          Grid.Row="1"
                          ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SceneExplorerModeButton"
                                Grid.Column="0"
                                Style="{StaticResource ExplorerModeButtonStyle}"
                                ToolTipService.ToolTip="Elementos presentes no mapa"
                                Click="OnSceneExplorerModeClick">
                            <StackPanel Spacing="1">
                                <TextBlock Text="◈"
                                           FontSize="14"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Cena"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="LibraryExplorerModeButton"
                                Grid.Column="1"
                                Style="{StaticResource ExplorerModeButtonStyle}"
                                ToolTipService.ToolTip="Biblioteca de itens do Workspace ou OMSI"
                                Click="OnLibraryModeClick">
                            <StackPanel Spacing="1">
                                <TextBlock Text="▦"
                                           FontSize="14"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Assets"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="MapExplorerModeButton"
                                Grid.Column="2"
                                Style="{StaticResource ExplorerModeButtonStyle}"
                                ToolTipService.ToolTip="Tiles, coordenadas e estrutura do mapa"
                                Click="OnMapExplorerModeClick">
                            <StackPanel Spacing="1">
                                <TextBlock Text="⌖"
                                           FontSize="14"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Mapa"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="TransportExplorerModeButton"
                                Grid.Column="3"
                                Style="{StaticResource ExplorerModeButtonStyle}"
                                ToolTipService.ToolTip="Tracks, Trips, Stops, StationLinks e Lines/Tours"
                                Click="OnToolTransportClick">
                            <StackPanel Spacing="1">
                                <TextBlock Text="↔"
                                           FontSize="14"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Transporte"
                                           FontSize="9.5"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid x:Name="ExplorerSearchGrid"
                          Grid.Row="2"
                          ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ExplorerSearchBox"
                                 Grid.Column="0"
                                 PlaceholderText="Buscar na área atual..."
                                 TextChanged="OnExplorerSearchTextChanged" />

                        <Button Grid.Column="1"
                                Width="34"
                                Content="⌕"
                                ToolTipService.ToolTip="Focar seleção atual"
                                Click="OnFocusSelectionClick" />
                    </Grid>

                    <Expander x:Name="ProjectSummaryCard"
                              Grid.Row="3"
                              Header="Ações do projeto"
                              IsExpanded="True"
                              HorizontalAlignment="Stretch">
                        <StackPanel Spacing="5"
                                    Padding="0,5,0,0">
                            <!-- Mantidos somente para compatibilidade com o estado atual;
                                 o cartão/resumo do nome do mapa não ocupa mais o painel Projeto. -->
                            <TextBlock x:Name="MapText"
                                       Visibility="Collapsed"
                                       Text="Nenhum mapa aberto." />
                            <TextBlock x:Name="RootText"
                                       Visibility="Collapsed"
                                       Text="Inicializando Workspace Map Studio..." />
                            <TextBlock x:Name="MapLoadModeText"
                                       Visibility="Collapsed"
                                       Text="mapa completo" />

                            <Grid ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Novo"
                                        ToolTipService.ToolTip="Criar um novo mapa no Workspace"
                                        Click="OnCreateStandaloneMapClick" />
                                <Button Grid.Column="1"
                                        Content="Abrir"
                                        ToolTipService.ToolTip="Abrir um mapa do catálogo"
                                        IsEnabled="{x:Bind OpenMapButton.IsEnabled, Mode=OneWay}"
                                        Click="OnOpenMapCatalogClick" />
                                <Button Grid.Column="2"
                                        Content="Importar"
                                        ToolTipService.ToolTip="Importar mapa existente para o Workspace"
                                        Click="OnImportStandaloneMapClick" />
                                <Button Grid.Column="3"
                                        Content="+ Assets"
                                        ToolTipService.ToolTip="Adicionar pasta de itens ao Workspace"
                                        Click="OnAddAssetFolderClick" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Grid Grid.Row="4">
                        <ListView x:Name="ExplorerListView"
                                  SelectionMode="Single"
                                  SelectionChanged="OnExplorerSelectionChanged"
                                  DoubleTapped="OnExplorerDoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2"
                                            Padding="8"
                                            Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                            BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    MinWidth="48"
                                                    Padding="6,4"
                                                    VerticalAlignment="Top"
                                                    Background="{ThemeResource MapStudioSurfaceRaisedBrush}"
                                                    CornerRadius="5">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource MapStudioAccentTextBrush}" />
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="2">
                                                <TextBlock Text="{Binding AssetName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource MapStudioTextPrimaryBrush}" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           FontSize="10"
                                                           Foreground="{ThemeResource MapStudioTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding AssetPath}"
                                                           FontSize="9.5"
                                                           Foreground="{ThemeResource MapStudioTextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid x:Name="MapExplorerPanel"
                              Visibility="Collapsed"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="9"
                                    Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                    BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="MAPA / TILES"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   CharacterSpacing="40"
                                                   Foreground="{ThemeResource MapStudioTextPrimaryBrush}" />
                                        <TextBlock x:Name="MapExplorerStatusText"
                                                   Text="Abra um mapa para visualizar os tiles."
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                                    </StackPanel>
                                    <Button x:Name="MapExplorerCollapseButton"
                                            Grid.Column="1"
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            Content="−"
                                            ToolTipService.ToolTip="Recolher/expandir card Mapa / Tiles"
                                            Click="OnMapExplorerCollapseClick" />
                                </Grid>
                            </Border>

                            <ListView x:Name="MapTileListView"
                                      Grid.Row="1"
                                      SelectionMode="Single"
                                      DisplayMemberPath="DisplayText"
                                      DoubleTapped="OnMapTileListDoubleTapped" />

                            <Grid x:Name="MapExplorerActionGrid"
                                  Grid.Row="2"
                                  ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Focar"
                                        Click="OnMapTileFocusClick" />
                                <Button Grid.Column="1"
                                        Content="Criar tile"
                                        Click="OnCreateMapTileClick" />
                                <Button Grid.Column="2"
                                        Content="Excluir tile"
                                        Click="OnDeleteActiveMapTileClick" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="AssetLibraryPanel"
                              Visibility="Collapsed"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Expander x:Name="AssetFiltersExpander"
                                      Grid.Row="0"
                                      Header="ASSETS · FILTROS"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch">
                                <ScrollViewer MaxHeight="340"
                                              VerticalScrollMode="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollMode="Disabled"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Border Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                        BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8">
                                    <StackPanel Spacing="7">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="BIBLIOTECA DE ASSETS"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       CharacterSpacing="40"
                                                       Foreground="{ThemeResource MapStudioTextPrimaryBrush}" />
                                            <TextBlock Text="Assets independentes do painel Projeto"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="5">
                                            <Button Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Content="↻"
                                                    ToolTipService.ToolTip="Reindexar biblioteca"
                                                    Click="OnRefreshLibraryClick" />
                                            <Button Width="72"
                                                    Height="28"
                                                    Padding="6,0"
                                                    Content="← Projeto"
                                                    ToolTipService.ToolTip="Voltar para Cena / Mapa / Transporte"
                                                    Click="OnCloseAssetLibraryModeClick" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBox x:Name="AssetLibrarySearchBox"
                                             PlaceholderText="Buscar assets, pastas, categorias..."
                                             TextChanged="OnAssetLibrarySearchTextChanged" />

                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="LibraryKindComboBox"
                                                  Grid.Column="0"
                                                  Header="Tipo"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnLibraryKindSelectionChanged">
                                            <ComboBoxItem Content="Todos" />
                                            <ComboBoxItem Content="Objetos SCO" />
                                            <ComboBoxItem Content="Splines SLI" />
                                            <ComboBoxItem Content="Modelos" />
                                            <ComboBoxItem Content="Texturas" />
                                        </ComboBox>

                                        <ComboBox x:Name="LibraryViewComboBox"
                                                  Grid.Column="1"
                                                  Header="Visão"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnLibraryViewSelectionChanged">
                                            <ComboBoxItem Content="Grupos" />
                                            <ComboBoxItem Content="Favoritos" />
                                            <ComboBoxItem Content="Recentes" />
                                            <ComboBoxItem Content="Frequentes" />
                                            <ComboBoxItem Content="Coleção" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="LibraryGroupComboBox"
                                                  Grid.Column="0"
                                                  Header="Categoria"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  DisplayMemberPath="Label"
                                                  SelectionChanged="OnLibraryGroupSelectionChanged" />

                                        <ComboBox x:Name="LibrarySubcategoryComboBox"
                                                  Grid.Column="1"
                                                  Header="Subcategoria"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnLibrarySubcategorySelectionChanged" />
                                    </Grid>

                                    <Border Background="{ThemeResource MapStudioSurfaceBrush}"
                                            BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="4">
                                        <TreeView x:Name="LibraryCategoryTreeView"
                                                  MaxHeight="170"
                                                  SelectionMode="Single"
                                                  SelectionChanged="OnLibraryCategoryTreeSelectionChanged" />
                                    </Border>

                                    <ComboBox x:Name="LibraryTechnicalFilterComboBox"
                                              Header="Filtro técnico"
                                              SelectedIndex="0"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnLibraryTechnicalFilterSelectionChanged" />

                                    <StackPanel x:Name="LibraryCollectionPanel"
                                                Visibility="Collapsed"
                                                Spacing="5">
                                        <ComboBox x:Name="LibraryCollectionComboBox"
                                                  Header="Coleção ativa"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnLibraryCollectionSelectionChanged" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="+ Nova coleção"
                                                    Click="OnCreateLibraryCollectionClick" />
                                            <Button Grid.Column="1"
                                                    Content="Excluir"
                                                    Click="OnDeleteLibraryCollectionClick" />
                                        </Grid>
                                    </StackPanel>
                                    </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </Expander>

                            <StackPanel Grid.Row="1"
                                        Spacing="6">
                                <Border Background="{ThemeResource MapStudioSurfaceRaisedBrush}"
                                        BorderBrush="{ThemeResource MapStudioBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="7">
                                    <StackPanel Spacing="6">
                                        <Button x:Name="PlaceAssetButton"
                                                Content="＋ Posicionar no mapa"
                                                IsEnabled="False"
                                                MinHeight="36"
                                                Background="{ThemeResource MapStudioAccentSurfaceBrush}"
                                                BorderBrush="{ThemeResource MapStudioAccentBrush}"
                                                HorizontalAlignment="Stretch"
                                                Click="OnPlaceAssetClick" />

                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="FavoriteAssetButton"
                                                    Grid.Column="0"
                                                    Content="☆ Favoritar"
                                                    IsEnabled="False"
                                                    Click="OnFavoriteAssetClick" />
                                            <Button x:Name="CollectionAssetButton"
                                                    Grid.Column="1"
                                                    Content="+ Coleção"
                                                    IsEnabled="False"
                                                    Click="OnCollectionAssetClick" />
                                        </Grid>

                                        <Button x:Name="AiClassifyAssetButton"
                                                Content="✦ IA: classificar asset"
                                                IsEnabled="False"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="Usar o provedor de IA ativo para revisar categoria e subcategoria"
                                                Click="OnAiClassifyAssetClick" />

                                        <Button x:Name="RepairDependencyButton"
                                                Content="Usar como substituição"
                                                Visibility="Collapsed"
                                                IsEnabled="False"
                                                HorizontalAlignment="Stretch"
                                                Click="OnRepairDependencyClick" />

                                        <Button x:Name="AssetPlacementOptionsToggleButton"
                                                Content="Opções avançadas ▾"
                                                IsEnabled="False"
                                                HorizontalAlignment="Stretch"
                                                Click="OnAssetPlacementOptionsToggleClick" />
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="ObjectPlacementOptionsPanel"
                                            Visibility="Collapsed"
                                            Spacing="6">
                                    <ComboBox x:Name="ConstructionPresetComboBox"
                                              Header="Preset de construção"
                                              SelectedIndex="0"
                                              SelectionChanged="OnConstructionPresetChanged">
                                        <ComboBoxItem Content="Personalizado" />
                                        <ComboBoxItem Content="Arborização de avenida" />
                                        <ComboBoxItem Content="Postes de iluminação" />
                                        <ComboBoxItem Content="Casas alinhadas" />
                                        <ComboBoxItem Content="Praça arborizada" />
                                        <ComboBoxItem Content="Grade / estacionamento" />
                                    </ComboBox>

                                    <ComboBox x:Name="ObjectPlacementModeComboBox"
                                              Header="Modo de posicionamento"
                                              SelectedIndex="0"
                                              SelectionChanged="OnObjectPlacementModeChanged">
                                        <ComboBoxItem Content="Único" />
                                        <ComboBoxItem Content="Repetir" />
                                        <ComboBoxItem Content="Linha" />
                                        <ComboBoxItem Content="Pincel / área" />
                                        <ComboBoxItem Content="Matriz" />
                                        <ComboBoxItem Content="Círculo" />
                                        <ComboBoxItem Content="Lotes" />
                                    </ComboBox>

                                    <Grid ColumnSpacing="6"
                                          RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <NumberBox x:Name="PlacementSpacingBox"
                                                   Grid.Row="0"
                                                   Grid.Column="0"
                                                   Header="Espaço (m)"
                                                   Minimum="0.5"
                                                   Maximum="100"
                                                   Value="12"
                                                   SmallChange="0.5" />
                                        <NumberBox x:Name="PlacementRadiusBox"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Header="Raio (m)"
                                                   Minimum="0.5"
                                                   Maximum="150"
                                                   Value="20"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementCountBox"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   Header="Quantidade"
                                                   Minimum="1"
                                                   Maximum="256"
                                                   Value="18"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementSetbackBox"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Header="Recuo (m)"
                                                   Minimum="-100"
                                                   Maximum="100"
                                                   Value="7"
                                                   SmallChange="0.5" />
                                        <NumberBox x:Name="PlacementRowsBox"
                                                   Grid.Row="2"
                                                   Grid.Column="0"
                                                   Header="Linhas"
                                                   Minimum="1"
                                                   Maximum="16"
                                                   Value="4"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementColumnsBox"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Header="Colunas"
                                                   Minimum="1"
                                                   Maximum="16"
                                                   Value="4"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="PlacementSpacingXBox"
                                                   Grid.Row="3"
                                                   Grid.Column="0"
                                                   Header="Espaço X"
                                                   Minimum="0.5"
                                                   Maximum="100"
                                                   Value="6"
                                                   SmallChange="0.5" />
                                        <NumberBox x:Name="PlacementSpacingZBox"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Header="Espaço Y"
                                                   Minimum="0.5"
                                                   Maximum="100"
                                                   Value="6"
                                                   SmallChange="0.5" />
                                    </Grid>

                                    <CheckBox x:Name="PlacementRandomRotationCheckBox"
                                              Content="Rotação variada" />

                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="PlacementAlignRoadCheckBox"
                                                  Grid.Column="0"
                                                  Content="Encaixar / alinhar à rua"
                                                  ToolTipService.ToolTip="Move o ghost para o eixo da spline mais próxima e alinha a rotação à tangente da via." />
                                        <NumberBox x:Name="PlacementRoadSnapDistanceBox"
                                                   Grid.Column="1"
                                                   Header="Alcance rua (m)"
                                                   Minimum="1"
                                                   Maximum="50"
                                                   Value="8"
                                                   SmallChange="1"
                                                   SpinButtonPlacementMode="Compact" />
                                    </Grid>

                                    <CheckBox x:Name="PlacementTangentCheckBox"
                                              Content="Círculo tangencial"
                                              IsChecked="True" />

                                    <TextBlock Text="Linha/Lotes: clique o início e depois o fim. Área, matriz e círculo usam o clique como centro."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                                </StackPanel>

                                <StackPanel x:Name="SplinePlacementOptionsPanel"
                                            Visibility="Collapsed"
                                            Spacing="5">
                                    <CheckBox x:Name="SplineEasyRoadCheckBox"
                                              Content="Estrada fácil (2 cliques)"
                                              Click="OnSplineEasyRoadToggle" />
                                    <CheckBox x:Name="SplineHeightCheckBox"
                                              Content="Criar como [spline_h] (altura)"
                                              Click="OnSplineHeightToggle" />
                                    <NumberBox x:Name="SplineCurveOffsetBox"
                                               Header="Curva lateral / offset (m)"
                                               Minimum="-500"
                                               Maximum="500"
                                               Value="0"
                                               SmallChange="0.5"
                                               SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnSplineCurveOffsetChanged" />
                                    <Grid x:Name="EasyRoadControlGrid"
                                          Visibility="Collapsed"
                                          ColumnSpacing="6"
                                          RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <NumberBox x:Name="EasyRoadStartXBox"
                                                   Grid.Row="0"
                                                   Grid.Column="0"
                                                   Header="Início X"
                                                   SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="EasyRoadStartZBox"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Header="Início Z"
                                                   SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="EasyRoadEndXBox"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   Header="Fim X"
                                                   SpinButtonPlacementMode="Compact" />
                                        <NumberBox x:Name="EasyRoadEndZBox"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Header="Fim Z"
                                                   SpinButtonPlacementMode="Compact" />
                                        <Button Grid.Row="2"
                                                Grid.Column="0"
                                                Content="Aplicar pontos"
                                                HorizontalAlignment="Stretch"
                                                Click="OnApplyEasyRoadPointsClick" />
                                        <Button Grid.Row="2"
                                                Grid.Column="1"
                                                Content="Confirmar via"
                                                HorizontalAlignment="Stretch"
                                                Click="OnConfirmEasyRoadClick" />
                                        <Button Grid.Row="3"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Content="Ajustar curva no mapa"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="Use o cursor como alça lateral da via; clique para fixar a curvatura."
                                                Click="OnAdjustEasyRoadCurveOnMapClick" />
                                    </Grid>
                                    <TextBlock Text="Estrada fácil: marque início e fim; use Ajustar curva no mapa para mover a alça visual, ou ajuste o offset numericamente; depois confirme. Offset 0 = reta."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource MapStudioTextMutedBrush}" />
                                    <CheckBox x:Name="SplineCurveCheckBox"
                                              Content="Curva manual (3 cliques)" />
                                    <CheckBox x:Name="SplineContinuousCheckBox"
                                              Content="Continuar segmentos"
                                              IsChecked="True" />
                                    <CheckBox x:Name="SplineEndpointSnapCheckBox"
                                              Content="Encaixar endpoints"
                                              IsChecked="True" />
                                    <NumberBox x:Name="SplineEndpointSnapDistanceBox"
                                               Header="Distância de snap (m)"
                                               Minimum="0.5"
                                               Maximum="30"
                                               Value="5"
                                               SmallChange="0.5"
                                               SpinButtonPlacementMode="Compact" />
                                    <CheckBox x:Name="SplineAutoConnectCheckBox"
                                              Content="Conectar Previous/Next automaticamente"
                                              IsChecked="True" />
                                    <NumberBox x:Name="SplineElevationOffsetBox"
                                               Header="Elevação adicional (m)"
                                               Minimum="-100"
                                               Maximum="300"
                                               Value="0"
                                               SmallChange="0.5"
                                               SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="LibraryStatusText"
                                       Grid.Row="2"
                                       Text="Índice de assets não carregado."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource MapStudioTextSecondaryBrush}" />

                            <Border x:Name="LibraryThumbnailBorder"
                                    Grid.Row="3"
                                    Height="128"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource MapStudioSurfaceBrush}"
                                    BorderBrush="{ThemeResource MapStudioBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4">
                                <Image x:Name="LibraryThumbnailImage"
                                       Stretch="Uniform" />
                            </Border>

                            <GridView x:Name="AssetLibraryListView"
                                      Grid.Row="4"
                                      ContainerContentChanging="OnAssetLibraryContainerContentChanging"
                                      SelectionMode="Single"
                                      CanDragItems="True"
                                      DragItemsStarting="OnAssetLibraryDragItemsStarting"
                                      SelectionChanged="OnAssetLibrarySelectionChanged"
                                      DoubleTapped="OnAssetLibraryDoubleTapped">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal"
                                                       ItemWidth="138"
                                                       ItemHeight="146" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="3"
                                                Width="130"
                                                Height="138"
                                                Padding="5"
                                                Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                                BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid RowSpacing="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="72" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Background="{ThemeResource MapStudioChromeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource MapStudioBorderStrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <Grid>
                                                        <Image Source="{Binding ThumbnailSource}"
                                                               Stretch="Uniform"
                                                               Margin="4,4,4,18" />
                                                        <Border HorizontalAlignment="Left"
                                                                VerticalAlignment="Bottom"
                                                                Margin="5"
                                                                Padding="5,2"
                                                                Background="{ThemeResource MapStudioTranslucentRaisedBrush}"
                                                                CornerRadius="4">
                                                            <TextBlock Text="{Binding KindLabel}"
                                                                       FontSize="9"
                                                                       Foreground="{ThemeResource MapStudioAccentTextBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding DisplayName}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource MapStudioTextPrimaryBrush}" />

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Detail}"
                                                           FontSize="9.5"
                                                           Foreground="{ThemeResource MapStudioTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Row="3"
                                                           Text="{Binding RelativePath}"
                                                           FontSize="8.5"
                                                           Foreground="{ThemeResource MapStudioTextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>

                        <Grid x:Name="TransportPanel"
                              Visibility="Collapsed"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="150" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0"
                                          HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="5">
                                    <Button Content="1 · Tracks"
                                            Click="OnTransportStepTracksClick" />
                                    <Button Content="2 · Station Links"
                                            Click="OnTransportStepStationLinksClick" />
                                    <Button Content="3 · Trips"
                                            Click="OnTransportStepTripsClick" />
                                    <Button Content="4 · Perfis"
                                            Click="OnTransportStepProfilesClick" />
                                    <Button Content="5 · Horários"
                                            Click="OnTransportStepTimetableClick" />
                                    <Button Content="Paradas"
                                            Click="OnTransportStepStopsClick" />
                                </StackPanel>
                            </ScrollViewer>

                            <ComboBox x:Name="TransportKindComboBox"
                                      Grid.Row="1"
                                      SelectedIndex="0"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnTransportKindSelectionChanged">
                                <ComboBoxItem Content="Tracks / caminhos (.ttr)" />
                                <ComboBoxItem Content="Trips / rotas (.ttp)" />
                                <ComboBoxItem Content="Stops / paradas (Busstops.cfg)" />
                                <ComboBoxItem Content="StationLinks (StnLinks.cfg)" />
                                <ComboBoxItem Content="Lines / Tours (.ttl)" />
                            </ComboBox>

                            <StackPanel Grid.Row="2"
                                        Spacing="5">
                                <TextBlock x:Name="TransportStatusText"
                                           Text="Nenhum TTData carregado."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource MapStudioTextSecondaryBrush}" />

                                <Expander x:Name="TransportPathsExpander"
                                          Header="PATHS · VISUALIZAÇÃO"
                                          IsExpanded="False"
                                          HorizontalAlignment="Stretch">
                                    <Border Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                            BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="7">
                                        <StackPanel Spacing="5">
                                            <ScrollViewer HorizontalScrollMode="Enabled"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollMode="Disabled"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="9">
                                                <CheckBox x:Name="TransportPathsVehiclesCheckBox"
                                                          Content="Veículos"
                                                          IsChecked="True"
                                                          Click="OnTransportPathFilterChanged" />
                                                <CheckBox x:Name="TransportPathsPedestriansCheckBox"
                                                          Content="Pedestres"
                                                          IsChecked="True"
                                                          Click="OnTransportPathFilterChanged" />
                                                <CheckBox x:Name="TransportPathsRailsCheckBox"
                                                          Content="Trilhos"
                                                          IsChecked="True"
                                                          Click="OnTransportPathFilterChanged" />
                                                <CheckBox x:Name="TransportPathsAirCheckBox"
                                                          Content="Aéreo"
                                                          IsChecked="True"
                                                          Click="OnTransportPathFilterChanged" />
                                                <CheckBox x:Name="TransportPathsWidthCheckBox"
                                                          Content="Largura"
                                                          Click="OnTransportPathFilterChanged" />
                                                <CheckBox x:Name="TransportPathsArrowsCheckBox"
                                                          Content="Setas"
                                                          IsChecked="True"
                                                          Click="OnTransportPathFilterChanged" />
                                                <CheckBox x:Name="TransportPathsNodesCheckBox"
                                                          Content="Nós"
                                                          IsChecked="True"
                                                          Click="OnTransportPathFilterChanged" />
                                                <CheckBox x:Name="TransportPathsLabelsCheckBox"
                                                          Content="Rótulos"
                                                          IsChecked="True"
                                                          Click="OnTransportPathFilterChanged" />
                                                <CheckBox x:Name="TransportPathsSignalsCheckBox"
                                                          Content="Destacar semáforo"
                                                          Click="OnTransportPathFilterChanged" />
                                                <CheckBox x:Name="TransportPathsSelectedOnlyCheckBox"
                                                          Content="Só selecionado"
                                                          Click="OnTrafficPathIsolationChanged" />
                                            </StackPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>

                            <ScrollViewer Grid.Row="3"
                                          HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="5">
                                    <Button x:Name="TransportNewButton"
                                            Content="+ Novo"
                                            Click="OnTransportNewClick" />
                                    <Button x:Name="TransportPreviewButton"
                                            Content="Rota completa"
                                            IsEnabled="False"
                                            Click="OnTransportPreviewClick" />
                                    <Button x:Name="TransportPathsButton"
                                            Content="Mostrar Paths"
                                            Click="OnTransportPathsClick" />
                                    <Button Content="Validar"
                                            ToolTipService.ToolTip="Validar referências Track/Trip/Stop/StationLink/Line e segmentos carregados"
                                            Click="OnTransportValidateClick" />
                                    <Button Content="Abrir Timetable ↗"
                                            ToolTipService.ToolTip="Abrir Lines/Tours/Trips em uma janela nativa separada"
                                            Click="OnOpenTimetableWindowClick" />
                                    <Button x:Name="TransportFocusStepButton"
                                            Content="Focar selecionado"
                                            IsEnabled="False"
                                            Click="OnTransportFocusStepClick" />
                                    <Button Content="Limpar preview"
                                            Click="OnTransportClearPreviewClick" />
                                </StackPanel>
                            </ScrollViewer>

                            <ListView x:Name="TransportListView"
                                      Grid.Row="4"
                                      SelectionMode="Single"
                                      DisplayMemberPath="DisplayText"
                                      SelectionChanged="OnTransportSelectionChanged" />

                            <Border Grid.Row="5"
                                    Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                    BorderBrush="{ThemeResource MapStudioBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="8,6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="ROUTE STUDIO"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               CharacterSpacing="90"
                                               Foreground="{ThemeResource MapStudioAccentTextBrush}" />
                                    <TextBlock x:Name="TransportRouteStatusText"
                                               Text="Fluxo: Track → Station Links → Trip → Perfil → Horário."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource MapStudioAccentTextBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="6"
                                    Background="{ThemeResource MapStudioSurfaceBrush}"
                                    BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="3">
                                <ListView x:Name="TransportRouteStepsListView"
                                          SelectionMode="Single"
                                          DisplayMemberPath="DisplayText"
                                          CanDragItems="True"
                                          CanReorderItems="True"
                                          AllowDrop="True"
                                          ToolTipService.ToolTip="Arraste os trechos para reordenar Track ou StationLink"
                                          DragItemsCompleted="OnTransportRouteDragItemsCompleted"
                                          SelectionChanged="OnTransportRouteStepSelectionChanged" />
                            </Border>

                            <Grid Grid.Row="7"
                                  ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Spacing="4">
                                    <ComboBox x:Name="TransportPathChoiceComboBox"
                                              Header="Faixa / path do item selecionado"
                                              DisplayMemberPath="DisplayText"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnTransportPathChoiceSelectionChanged" />
                                    <TextBlock x:Name="TransportPathChoiceHintText"
                                               Text="Selecione uma spline/objeto no mapa para listar as faixas disponíveis."
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource MapStudioTextMutedBrush}" />

                                    <NumberBox x:Name="TransportPathIndexBox"
                                               Visibility="Collapsed"
                                               Minimum="0"
                                               Maximum="100000"
                                               Value="0"
                                               SmallChange="1" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="5"
                                            VerticalAlignment="Bottom">
                                    <Button Content="← faixa"
                                            Click="OnTransportPreviousLaneClick" />
                                    <Button Content="faixa →"
                                            Click="OnTransportNextLaneClick" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="8"
                                          HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="5">
                                    <Button x:Name="TransportRecordButton"
                                            Content="● Gravar caminho"
                                            IsEnabled="False"
                                            ToolTipService.ToolTip="Clique nas splines/objetos na ordem da rota; a faixa escolhida é gravada no Track ou StationLink selecionado"
                                            Click="OnTransportRecordClick" />
                                    <Button x:Name="TransportAddSelectionButton"
                                            Content="+ trecho selecionado"
                                            IsEnabled="False"
                                            ToolTipService.ToolTip="Adiciona o path atual quando o contexto de Track/StationLink é válido"
                                            Click="OnTransportAddSelectionClick" />
                                    <Button x:Name="TransportRemoveStepButton"
                                            Content="Remover"
                                            IsEnabled="False"
                                            Click="OnTransportRemoveStepClick" />
                                    <Button x:Name="TransportMoveStepUpButton"
                                            Content="↑ ordem"
                                            IsEnabled="False"
                                            Click="OnTransportMoveStepUpClick" />
                                    <Button x:Name="TransportMoveStepDownButton"
                                            Content="↓ ordem"
                                            IsEnabled="False"
                                            Click="OnTransportMoveStepDownClick" />
                                    <Button x:Name="TransportProfilesButton"
                                            Content="Editar perfil de tempo"
                                            IsEnabled="False"
                                            Click="OnTransportProfilesClick" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="9"
                                        Spacing="5">
                                <TextBlock x:Name="TransportDetailText"
                                           Text="Selecione um item para ver detalhes."
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource MapStudioTextSecondaryBrush}" />
                                <Button x:Name="EditTrackButton"
                                        Content="Editar"
                                        Visibility="Collapsed"
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        Click="OnEditTrackClick" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="TrafficControlPanel"
                              Visibility="Collapsed"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Tráfego OMSI"
                                       FontSize="15"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="TrafficStatusText"
                                       Grid.Row="1"
                                       Text="Nenhum dado de tráfego carregado."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource MapStudioTextSecondaryBrush}" />

                            <ComboBox x:Name="TrafficViewComboBox"
                                      Grid.Row="2"
                                      SelectedIndex="0"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Semáforos e fases" />
                                <ComboBoxItem Content="Traffic Rules" />
                            </ComboBox>

                            <Border Grid.Row="3"
                                    Background="{ThemeResource MapStudioSurfaceAltBrush}"
                                    BorderBrush="{ThemeResource MapStudioBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="7">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Paths no mapa"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource MapStudioTextPrimaryBrush}" />
                                    <ComboBox x:Name="TrafficPathModeComboBox"
                                              SelectedIndex="3"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnTrafficPathModeChanged">
                                        <ComboBoxItem Content="Veículos · visão limpa" />
                                        <ComboBoxItem Content="Pedestres" />
                                        <ComboBoxItem Content="Trilhos" />
                                        <ComboBoxItem Content="Todos os tipos" />
                                    </ComboBox>
                                    <ScrollViewer HorizontalScrollMode="Enabled"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollMode="Disabled"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10">
                                            <CheckBox x:Name="TrafficPathWidthCheckBox"
                                                      Content="Largura"
                                                      Click="OnTrafficPathModeChanged" />
                                            <CheckBox x:Name="TrafficPathArrowsCheckBox"
                                                      Content="Setas"
                                                      IsChecked="True"
                                                      Click="OnTrafficPathModeChanged" />
                                            <CheckBox x:Name="TrafficPathNodesCheckBox"
                                                      Content="Nós"
                                                      IsChecked="True"
                                                      Click="OnTrafficPathModeChanged" />
                                            <CheckBox x:Name="TrafficPathLabelsCheckBox"
                                                      Content="Rótulos"
                                                      IsChecked="True"
                                                      Click="OnTrafficPathModeChanged" />
                                            <CheckBox x:Name="TrafficPathSignalsCheckBox"
                                                      Content="Semáforos em vermelho"
                                                      Click="OnTrafficPathModeChanged" />
                                            <CheckBox x:Name="TrafficPathSelectedOnlyCheckBox"
                                                      Content="Só selecionado"
                                                      Click="OnTrafficPathIsolationChanged" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="4">
                                <Grid x:Name="TrafficSignalsPanel"
                                      RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ListView x:Name="TrafficProgramListView"
                                              Grid.Row="0"
                                              Height="132"
                                              SelectionMode="Single"
                                              DisplayMemberPath="DisplayText"
                                              SelectionChanged="OnTrafficProgramSelectionChanged" />

                                    <StackPanel Grid.Row="1"
                                                Spacing="4">
                                        <Slider x:Name="TrafficPreviewTimeSlider"
                                                Minimum="0"
                                                Maximum="60"
                                                StepFrequency="0.25"
                                                ValueChanged="OnTrafficPreviewTimeChanged" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <Button x:Name="TrafficPlayButton"
                                                    Content="▶ Play"
                                                    Click="OnTrafficPlayClick" />
                                            <TextBlock x:Name="TrafficPhaseText"
                                                       VerticalAlignment="Center"
                                                       Text="Fase: —" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ListView x:Name="TrafficPhaseListView"
                                              Grid.Row="2"
                                              SelectionMode="None" />
                                </Grid>

                                <Grid x:Name="TrafficRulesPanel"
                                      Visibility="Collapsed"
                                      RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ComboBox x:Name="TrafficVehicleGroupComboBox"
                                              Grid.Row="0"
                                              Header="Grupo de veículo"
                                              DisplayMemberPath="Name"
                                              HorizontalAlignment="Stretch" />

                                    <ComboBox x:Name="TrafficRulePresetComboBox"
                                              Grid.Row="1"
                                              Header="Regra do editor OMSI"
                                              DisplayMemberPath="DisplayName"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="OnTrafficRulePresetSelectionChanged" />

                                    <Grid Grid.Row="2"
                                          ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="TrafficRulePathIndexBox"
                                                   Grid.Column="0"
                                                   Header="Path index"
                                                   Minimum="0"
                                                   Maximum="100000"
                                                   Value="0"
                                                   SmallChange="1" />
                                        <NumberBox x:Name="TrafficRuleValueBox"
                                                   Grid.Column="1"
                                                   Header="Valor"
                                                   Minimum="-1000000"
                                                   Maximum="1000000"
                                                   Value="0"
                                                   SmallChange="0.1" />
                                    </Grid>

                                    <CheckBox x:Name="TrafficRuleKillCheckBox"
                                              Grid.Row="3"
                                              Content="Usar [kill_rule]" />

                                    <ListView x:Name="TrafficRuleListView"
                                              Grid.Row="4"
                                              SelectionMode="Single"
                                              DisplayMemberPath="DisplayText"
                                              SelectionChanged="OnTrafficRuleSelectionChanged" />

                                    <StackPanel Grid.Row="5"
                                                Spacing="5">
                                        <Button x:Name="ApplyTrafficRuleButton"
                                                Content="Aplicar / adicionar regra"
                                                HorizontalAlignment="Stretch"
                                                Click="OnApplyTrafficRuleClick" />
                                        <Button x:Name="DeleteTrafficRuleButton"
                                                Content="Excluir regra selecionada"
                                                IsEnabled="False"
                                                HorizontalAlignment="Stretch"
                                                Click="OnDeleteTrafficRuleClick" />
                                        <Button x:Name="FocusTrafficRuleOwnerButton"
                                                Content="Focar regra no mapa"
                                                IsEnabled="False"
                                                HorizontalAlignment="Stretch"
                                                Click="OnFocusTrafficRuleOwnerClick" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <TextBlock x:Name="TrafficDetailText"
                                       Grid.Row="5"
                                       Text="Selecione um programa ou Traffic Rule."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource MapStudioTextSecondaryBrush}" />

                            <StackPanel Grid.Row="6"
                                        Spacing="5">
                                <Button x:Name="EditSceneryPathButton"
                                        Content="Editar paths do item..."
                                        IsEnabled="False"
                                        HorizontalAlignment="Stretch"
